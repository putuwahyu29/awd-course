# ==============================================================================
# AWD COURSE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE AUTHENTICATION (Google One-Click Login & Progress Tracking)
# ------------------------------------------------------------------------------
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. KEYSTATIC CMS GITHUB OAUTH (Admin CMS Security on Production)
# ------------------------------------------------------------------------------
# Di lingkungan produksi (Vercel), Keystatic mewajibkan login GitHub untuk mengakses /keystatic.
# Hanya akun GitHub yang terdaftar sebagai Collaborator/Owner repository yang dapat mengakses & mengedit konten.

PUBLIC_KEYSTATIC_GITHUB_OWNER=putuaguswahyu
PUBLIC_KEYSTATIC_GITHUB_REPO=awd-course

# Buat GitHub OAuth App di GitHub Developer Settings (https://github.com/settings/developers)
# Authorization callback URL: https://awd-course.vercel.app/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=your-github-oauth-client-id
KEYSTATIC_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
KEYSTATIC_SECRET=your-random-32-character-secret-key-here

# ------------------------------------------------------------------------------
# 3. AI CHATBOT INTEGRATION (AwdBot Assistant)
# ------------------------------------------------------------------------------
# OPSI A: CLOUDFLARE WORKERS AI (GRATIS 10.000 Neurons/hari - Direkomendasikan)
# Dapatkan Account ID di Dashboard Cloudflare (sidebar kanan)
# Buat API Token di Cloudflare Dashboard -> My Profile -> API Tokens -> Template "Workers AI"
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# Model pilihan: @cf/meta/llama-3.1-8b-instruct (cepat, hemat) atau @cf/meta/llama-3.3-70b-instruct
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# OPSI B: MISTRAL AI (Alternatif)
# Dapatkan API Key di Mistral Console (https://console.mistral.ai/)
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-small-latest


# ------------------------------------------------------------------------------
# 4. IN-BROWSER CODE RUNNER (Pyodide WebAssembly)
# ------------------------------------------------------------------------------
# Atur ke true jika ingin mengizinkan eksekusi kode Python langsung di browser siswa.
# Nilai default: false (disarankan tetap false untuk menghemat bandwidth & performa cepat).
PUBLIC_ENABLE_CODE_RUNNER=false

