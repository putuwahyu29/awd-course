    padding: 5rem 0 4rem 0;
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-inner {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-pill-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--primary);
    background-color: var(--primary-light);
    border: 1px solid var(--primary-border);
    border-radius: 99px;
    margin-bottom: 1.5rem;
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--primary);
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--text-main);
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2.25rem;
    max-width: 700px;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-md);
  }

  /* Spotlight Course */
  .featured-spotlight-section {
    padding: 3.5rem 0 1.5rem 0;
  }

  .spotlight-card {
    padding: 2.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-sm);
  }

  .spotlight-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
  }

  .spotlight-course-title {
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 800;
    color: var(--text-main);
    margin: 0.6rem 0 0.5rem 0;
    letter-spacing: -0.01em;
  }

  .spotlight-course-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 750px;
    margin: 0;
  }

  .spotlight-meta-badges {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-end;
  }

  .spotlight-date-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    background-color: var(--bg-surface-elevated);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    white-space: nowrap;
  }

  .spotlight-curriculum-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .spotlight-curriculum-item {
    display: flex;
    align-items: flex-start;
    gap: 1.15rem;
    padding: 1.15rem 1.35rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    transition: border-color 0.15s ease;
  }

  .spotlight-curriculum-item:hover {
    border-color: var(--primary);
  }

  .curriculum-num {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background-color: var(--primary-light);
    border: 1px solid var(--primary-border);
    color: var(--primary);
    font-size: 0.875rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .curriculum-info {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex-grow: 1;
  }

  .curriculum-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .curriculum-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .curriculum-count {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--primary);
    background-color: var(--primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }

  .curriculum-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .spotlight-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
    flex-wrap: wrap;
  }

  .spotlight-instructor {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .spotlight-instructor strong {
    color: var(--text-main);
  }

  /* Highlights 3-Column Section */
  .highlights-section {
    padding: 3rem 0;
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .highlight-card {
    padding: 1.75rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
  }

  .highlight-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background-color: var(--primary-light);
    border: 1px solid var(--primary-border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.15rem;
  }

  .highlight-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
  }

  .highlight-desc {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Courses Catalog */
  .courses-catalog-section {
    padding: 4.5rem 0;
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-heading-flex {
    margin-bottom: 2.25rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .section-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  /* Instructor */
  .instructor-section {
    padding: 4.5rem 0;
  }

  .instructor-card {
    padding: 2.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
  }

  .instructor-layout {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .instructor-photo {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border-medium);
  }

  .instructor-name-heading {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-main);
    margin: 0.5rem 0 0.25rem 0;
  }

  .instructor-designation {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .instructor-summary {
    font-size: 0.925rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .instructor-actions {
    margin-top: 1.15rem;
    display: flex;
    align-items: center;
  }

  .instructor-portfolio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .instructor-portfolio-link:hover {
    color: var(--primary-hover);
    gap: 0.5rem;
  }

  .instructor-portfolio-link svg {
    transition: transform 0.15s ease;
  }

  .instructor-portfolio-link:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 1024px) {
    .instructor-layout {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .instructor-avatar-container {
      display: flex;
      justify-content: center;
    }
    .instructor-actions {
      justify-content: center;
    }
    .spotlight-meta-badges {
      align-items: flex-start;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 3rem 0 2.25rem 0;
    }
    .hero-title {
      font-size: 2rem;
      letter-spacing: -0.02em;
    }
    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 1.75rem;
    }
    .hero-actions {
      flex-direction: column;
      width: 100%;
      max-width: 360px;
      margin-left: auto;
      margin-right: auto;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .hero-actions .btn {
      width: 100%;
      justify-content: center;
    }
    .hero-metrics-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      width: 100%;
      max-width: 360px;
      border-radius: var(--radius-lg);
      padding: 0.85rem 1.15rem;
    }
    .metric-sep {
      display: none;
    }
    .spotlight-card {
      padding: 1.35rem 1.15rem;
    }
    .spotlight-header {
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .spotlight-meta-badges {
      width: 100%;
      align-items: flex-start;
    }
    .spotlight-curriculum-item {
      padding: 0.85rem 1rem;
      gap: 0.75rem;
    }
    .curriculum-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.35rem;
    }
    .spotlight-footer {
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      text-align: center;
    }
    .spotlight-footer .btn {
      width: 100%;
      justify-content: center;
    }
    .highlights-section {
      padding: 2.25rem 0;
    }
    .highlights-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .courses-catalog-section {
      padding: 3rem 0;
    }
    .courses-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .instructor-section {
      padding: 3rem 0;
    }
    .instructor-card {
      padding: 1.75rem 1.25rem;
    }
