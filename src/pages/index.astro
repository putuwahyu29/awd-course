---
import BaseLayout from '../layouts/BaseLayout.astro';
import CourseCard from '../components/CourseCard.astro';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');

// Filter only published courses and published lessons
const publishedCourses = allCourses
  .filter((c) => c.data.isPublished && c.data.status !== 'draft')
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));

const lessonCountByCourse: Record<string, number> = {};
allLessons
  .filter((l) => l.data.isPublished !== false)
  .forEach((l) => {
    const cSlug = l.data.courseSlug;
    lessonCountByCourse[cSlug] = (lessonCountByCourse[cSlug] || 0) + 1;
  });

const pythonCourse = publishedCourses.find((c) => c.id === 'python-data-science') || publishedCourses[0];

function formatIndonesianDate(dateStr?: string): string {
  if (!dateStr) return '';
  try {
    const parts = dateStr.split('-');
    if (parts.length === 3) {
      const months = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
      const mIdx = parseInt(parts[1], 10) - 1;
      return `${parseInt(parts[2], 10)} ${months[mIdx] || parts[1]} ${parts[0]}`;
    }
  } catch (e) {}
  return dateStr;
}

const formattedPythonDate = formatIndonesianDate(pythonCourse?.data?.updatedAt);

const pythonLessons = allLessons.filter(
  (l) => l.data.courseSlug === (pythonCourse?.id || 'python-data-science') && l.data.isPublished !== false
);
const bab1Count = pythonLessons.filter((l) => l.data.chapter?.includes('Bab 1')).length;
const bab2Count = pythonLessons.filter((l) => l.data.chapter?.includes('Bab 2')).length;
---

<BaseLayout
  title="Platform Pembelajaran Teknis"
  description="Platform pembelajaran terstruktur untuk pemrograman dan analisis data dengan modul bacaan teknis dan lingkungan eksekusi kode interaktif."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-inner">
        <h1 class="hero-title">
          Platform Pembelajaran Teknis Terstruktur
        </h1>

        <p class="hero-subtitle">
          Kuasai fondasi rekayasa perangkat lunak, sistem komputasi, dan analisis data melalui modul sistematis dengan lingkungan eksekusi kode interaktif langsung di peramban.
        </p>

        <div class="hero-actions">
          {pythonCourse && (
            <a href={`/courses/${pythonCourse.id}`} class="btn btn-primary btn-lg hero-cta">
              <span>Mulai Belajar Sekarang</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          )}
          <a href="/courses" class="btn btn-outline btn-lg">
            Jelajahi Katalog Kursus
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Course Section -->
  {pythonCourse && (
    <section class="featured-spotlight-section">
      <div class="container">
        <div class="spotlight-card card">
          <div class="spotlight-header">
            <div>
              <span class="badge badge-primary">Materi Unggulan Aktif</span>
              <h2 class="spotlight-course-title">{pythonCourse.data.title}</h2>
              <p class="spotlight-course-desc">{pythonCourse.data.description}</p>
            </div>
            
            <div class="spotlight-meta-badges">
              <div class="spotlight-date-tag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
                  <circle cx="12" cy="12" r="10"></circle>
                  <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                <span>Durasi: {pythonCourse.data.duration || '6 Jam'}</span>
              </div>
              <div class="spotlight-date-tag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>Pembaruan: {formattedPythonDate || '8 September 2026'}</span>
              </div>
            </div>
          </div>

          <!-- 3 Structured Chapters -->
          <div class="spotlight-curriculum-list">
            <div class="spotlight-curriculum-item">
              <span class="curriculum-num">1</span>
              <div class="curriculum-info">
                <div class="curriculum-top">
                  <strong class="curriculum-title">Bab 1: Dasar Pemrograman Python</strong>
                  <span class="curriculum-count">{bab1Count || 8} Modul Materi</span>
                </div>
                <span class="curriculum-desc">Sintaksis dasar, tipe data, variabel, operator, percabangan kondisional, perulangan loop, pembuatan fungsi, modul PDF, dan tugas praktik kalkulator interaktif.</span>
              </div>
            </div>

            <div class="spotlight-curriculum-item">
              <span class="curriculum-num">2</span>
              <div class="curriculum-info">
                <div class="curriculum-top">
                  <strong class="curriculum-title">Bab 2: Pengenalan Package Python</strong>
                  <span class="curriculum-count">{bab2Count || 8} Modul Materi</span>
                </div>
                <span class="curriculum-desc">Manajemen paket dengan pip, komputasi array multidimensi NumPy, struktur DataFrame Pandas, visualisasi Matplotlib & Seaborn, modul PDF, dan tugas praktik mandiri.</span>
              </div>
            </div>

            <div class="spotlight-curriculum-item" style="opacity: 0.85;">
              <span class="curriculum-num">3</span>
              <div class="curriculum-info">
                <div class="curriculum-top">
                  <strong class="curriculum-title">Bab 3: Analisis Data Eksploratif (EDA)</strong>
                  <span class="curriculum-count" style="background-color: var(--bg-surface-elevated); border: 1px solid var(--border-medium); color: var(--text-muted);">Segera Hadir</span>
                </div>
                <span class="curriculum-desc">Persiapan & inspeksi struktur awal dataframe, ringkasan statistik deskriptif dan plot sebaran, serta seleksi kolom dan filtering baris dengan Boolean indexing.</span>
              </div>
            </div>
          </div>

          <div class="spotlight-footer">
            <a href={`/courses/${pythonCourse.id}`} class="btn btn-primary btn-lg">
              <span>Buka Materi Pembelajaran</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" aria-hidden="true">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
            <div class="spotlight-instructor">
              <span>Pemateri: <strong>{pythonCourse.data.instructor}</strong> ({pythonCourse.data.instructorRole})</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Platform Highlights 3-Column Section -->
  <section class="highlights-section">
    <div class="container">
      <div class="highlights-grid">
        <div class="highlight-card card">
          <div class="highlight-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" class="text-primary">
              <polyline points="4 17 10 11 4 5"></polyline>
              <line x1="12" y1="19" x2="20" y2="19"></line>
            </svg>
          </div>
          <h3 class="highlight-title">Lingkungan Latihan Kode Interaktif</h3>
          <p class="highlight-desc">
            Jalankan latihan praktikum kode langsung di peramban tanpa konfigurasi server yang rumit, lengkap dengan editor interaktif dan keluaran instan.
          </p>
        </div>

        <div class="highlight-card card">
          <div class="highlight-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" class="text-primary">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="highlight-title">Mode Slide Presentasi Lengkap</h3>
          <p class="highlight-desc">
            Tekan tombol <strong>P</strong> di setiap materi untuk mengaktifkan slide tayangan proyektor kelas dengan laser virtual dan tema Dark/Light.
          </p>
        </div>

        <div class="highlight-card card">
          <div class="highlight-icon-box">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" class="text-primary">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <h3 class="highlight-title">Dasbor & Pelacakan Progres</h3>
          <p class="highlight-desc">
            Masuk dengan 1-klik akun Google untuk memantau modul yang telah diselesaikan dan melanjutkan pembelajaran kapan saja.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Published Courses List -->
  <section class="courses-catalog-section">
    <div class="container">
      <div class="section-heading-flex">
        <div>
          <h2 class="section-title">Katalog Kursus Pembelajaran</h2>
          <p class="section-desc">Pilih kurikulum teknis yang dirancang terstruktur untuk berbagai jenjang keahlian.</p>
        </div>
      </div>

      <div class="courses-grid">
        {publishedCourses.map((course) => (
          <CourseCard
            course={course}
            lessonCount={lessonCountByCourse[course.id] || 0}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Instructor Section -->
  <section class="instructor-section">
    <div class="container">
      <div class="instructor-card card">
        <div class="instructor-layout">
          <div class="instructor-avatar-container">
            <img
              src="/images/instructors/wahyu-dupayana.jpg"
              alt="I Putu Agus Wahyu Dupayana"
              class="instructor-photo"
            />
          </div>

          <div class="instructor-details">
            <span class="badge badge-primary">Pemateri Resmi</span>
            <h2 class="instructor-name-heading">I Putu Agus Wahyu Dupayana</h2>
            <p class="instructor-designation">Software Engineer • AWD.dev</p>
            <p class="instructor-summary">
              Praktisi rekayasa perangkat lunak dan pengolahan data dengan dedikasi dalam membangun kurikulum terstruktur yang menggabungkan rekayasa perangkat lunak, komputasi awan modern, dan analisis data berstandar industri.
            </p>
            <div class="instructor-actions">
              <a
                href="https://awd.my.id"
                target="_blank"
                rel="noopener noreferrer"
                class="instructor-portfolio-link"
              >
                <span>Lihat Portofolio</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17L17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
