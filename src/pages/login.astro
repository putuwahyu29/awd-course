---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Masuk / Daftar Akun"
  description="Masuk ke Awd Course menggunakan akun Google Anda."
>
  <div class="auth-page-container">
    <div class="auth-card card">
      <div class="auth-header">
        <div class="auth-logo-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="24" height="24">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
        <h1 class="auth-title">Masuk ke Awd Course</h1>
        <p class="auth-subtitle">Akses modul kursus dan simpan progres belajar Anda secara otomatis di cloud.</p>
      </div>

      <!-- Alert Message Box -->
      <div id="auth-alert" class="auth-alert hidden"></div>

      <!-- Single Google OAuth Button -->
      <button type="button" id="google-auth-btn" class="btn btn-primary btn-block google-signin-btn">
        <svg viewBox="0 0 24 24" width="20" height="20" class="google-icon-svg">
          <path fill="#ffffff" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#ffffff" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#ffffff" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#ffffff" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span class="btn-text">Lanjutkan dengan Google</span>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase, isSupabaseConfigured } from '../lib/supabase';

  function initGoogleAuth() {
    const alertBox = document.getElementById('auth-alert');
    const googleBtn = document.getElementById('google-auth-btn') as HTMLButtonElement;
    const btnText = googleBtn?.querySelector('.btn-text');

    function showAlert(message: string, isError = true) {
      if (!alertBox) return;
      alertBox.textContent = message;
      alertBox.className = `auth-alert ${isError ? 'alert-error' : 'alert-success'}`;
      alertBox.classList.remove('hidden');
    }

    // Redirect already authenticated users to dashboard
    if (isSupabaseConfigured && supabase) {
      supabase.auth.getUser().then(({ data: { user } }) => {
        if (user) {
          window.location.replace('/dashboard');
        }
      });
    }

    if (googleBtn) {
      googleBtn.onclick = async () => {
        if (!isSupabaseConfigured || !supabase) {
          showAlert('Layanan autentikasi cloud belum dikonfigurasi (.env). Anda tetap dapat mengakses materi pembelajaran secara langsung tanpa login.');
          return;
        }

        googleBtn.disabled = true;
        if (btnText) btnText.textContent = 'Menghubungkan ke Google...';

        function getFriendlyAuthError(rawMsg?: string): string {
          if (!rawMsg) return 'Terjadi kendala saat menghubungkan ke akun Google. Silakan coba kembali.';
          const lower = rawMsg.toLowerCase();
          if (lower.includes('popup') || lower.includes('closed') || lower.includes('cancel')) {
            return 'Proses login dibatalkan atau jendela Google ditutup. Silakan coba kembali jika ingin masuk.';
          }
          if (lower.includes('network') || lower.includes('fetch') || lower.includes('connection')) {
            return 'Koneksi internet terputus saat menghubungkan ke Google. Silakan periksa jaringan Anda lalu coba lagi.';
          }
          if (lower.includes('provider') || lower.includes('not enabled') || lower.includes('redirect')) {
            return 'Layanan login Google sedang dalam pemeliharaan konfigurasi. Anda tetap dapat mengakses seluruh materi kursus tanpa perlu login.';
          }
          return 'Mohon maaf, terjadi kendala saat memproses login Google. Silakan coba kembali dalam beberapa saat.';
        }

        try {
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: `${window.location.origin}/auth/callback`,
            },
          });
          if (error) {
            console.error('Supabase OAuth error:', error);
            showAlert(getFriendlyAuthError(error.message));
            googleBtn.disabled = false;
            if (btnText) btnText.textContent = 'Lanjutkan dengan Google';
          }
        } catch (err: any) {
          console.error('OAuth network exception:', err);
          showAlert(getFriendlyAuthError(err.message));
          googleBtn.disabled = false;
          if (btnText) btnText.textContent = 'Lanjutkan dengan Google';
        }
      };
    }
  }

  document.addEventListener('astro:page-load', initGoogleAuth);
</script>

<style>
  .auth-page-container {
    min-height: calc(100vh - 180px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
  }

  .auth-card {
    width: 100%;
    max-width: 400px;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    text-align: center;
  }

  .auth-header {
    margin-bottom: 2rem;
  }

  .auth-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background-color: var(--primary-light);
    color: var(--primary);
    margin-bottom: 1.15rem;
  }

  .auth-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--text-main);
    letter-spacing: -0.01em;
  }

  .auth-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }

  .auth-alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.825rem;
    margin-bottom: 1.5rem;
    line-height: 1.45;
    text-align: left;
  }

  .alert-error {
    background-color: rgba(225, 29, 72, 0.1);
    color: var(--accent-rose);
    border: 1px solid var(--accent-rose);
  }

  .alert-success {
    background-color: rgba(5, 150, 105, 0.1);
    color: var(--accent-emerald);
    border: 1px solid var(--accent-emerald);
  }

  .google-signin-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: var(--radius-md);
    width: 100%;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .google-signin-btn:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
  }

  .google-icon-svg {
    flex-shrink: 0;
  }

  .hidden {
    display: none !important;
  }
</style>
