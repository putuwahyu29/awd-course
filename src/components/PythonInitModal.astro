<script>
  // Global Controller for Python Initialization Warning Modal
  const STORAGE_KEY = 'awd_python_init_confirmed';
  let pendingCallback: (() => void) | null = null;

  function initPythonModal() {
    const modal = document.getElementById('awd-py-init-modal');
    const overlay = document.getElementById('py-modal-backdrop-overlay');
    const closeX = document.getElementById('py-modal-close-x');
    const btnCancel = document.getElementById('py-modal-btn-cancel');
    const btnConfirm = document.getElementById('py-modal-btn-confirm');
    const dontAskCheckbox = document.getElementById('py-modal-dont-ask') as HTMLInputElement | null;

    if (!modal) return;

    function closeModal() {
      modal?.classList.add('hidden');
      modal?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('py-modal-open');
      pendingCallback = null;
    }

    function confirmAndRun() {
      if (dontAskCheckbox?.checked) {
        try {
          localStorage.setItem(STORAGE_KEY, 'true');
        } catch {}
      }
      (window as any)._awdPythonInitSessionConfirmed = true;

      const cb = pendingCallback;
      closeModal();

      if (typeof cb === 'function') {
        cb();
      }
    }

    overlay?.addEventListener('click', closeModal);
    closeX?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);
    btnConfirm?.addEventListener('click', confirmAndRun);

    // Escape & Enter key listeners
    window.addEventListener('keydown', (e) => {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'Enter' && !e.shiftKey && !e.ctrlKey) {
        e.preventDefault();
        confirmAndRun();
      }
    });

    // Expose global execution confirmation gatekeeper
    (window as any).awdConfirmPythonRun = function (onConfirmed: () => void) {
      // 1. Check if user already confirmed permanently in localStorage
      try {
        if (localStorage.getItem(STORAGE_KEY) === 'true') {
          onConfirmed();
          return;
        }
      } catch {}

      // 2. Check if user already confirmed in current tab session
      if ((window as any)._awdPythonInitSessionConfirmed) {
        onConfirmed();
        return;
      }

      // 3. Otherwise show modal dialog
      pendingCallback = onConfirmed;
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('py-modal-open');
      btnConfirm?.focus();
    };
  }

  // Setup on page load and view transitions
  initPythonModal();
  document.addEventListener('astro:page-load', initPythonModal);
</script>

