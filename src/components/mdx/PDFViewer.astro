---
interface Props {
  file: string;
  title?: string;
  description?: string;
  height?: string;
}

const {
  file,
  title = 'Modul Panduan & Materi Kursus (PDF)',
  description = 'Anda dapat membaca modul PDF di bawah ini atau mengunduhnya untuk dipelajari secara offline.',
  height = '520px',
} = Astro.props;
---

<div class="pdf-viewer-card my-5">
  <div class="pdf-header">
    <div class="pdf-info">
      <div class="pdf-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
      </div>
      <div class="pdf-text-details">
        <h4 class="pdf-title">{title}</h4>
        <p class="pdf-desc">{description}</p>
      </div>
    </div>
    <div class="pdf-actions">
      <a href={file} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
        Buka Tab Baru
      </a>
      <a href={file} download class="btn btn-primary btn-sm">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Unduh PDF
      </a>
    </div>
  </div>

  <div class="pdf-container" style={`height: ${height};`}>
    <object
      data={`${file}#toolbar=1&navpanes=0`}
      type="application/pdf"
      width="100%"
      height="100%"
      class="pdf-object"
    >
      <iframe src={file} width="100%" height="100%" title={title}>
        <div class="pdf-fallback p-4 text-center">
          <p class="mb-3">Dokumen PDF dapat diunduh langsung untuk dibaca secara offline.</p>
          <a href={file} download class="btn btn-primary btn-sm">
            Unduh Dokumen PDF
          </a>
        </div>
      </iframe>
    </object>
  </div>
</div>

<style>
  .pdf-viewer-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 1.75rem 0;
  }

  .pdf-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .pdf-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .pdf-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background-color: rgba(225, 29, 72, 0.1);
    color: var(--accent-rose);
    flex-shrink: 0;
  }

  .pdf-icon svg {
    width: 20px;
    height: 20px;
  }

  .pdf-text-details {
    min-width: 0;
  }

  .pdf-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
    line-height: 1.3;
  }

  .pdf-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0.15rem 0 0 0;
    line-height: 1.4;
  }

  .pdf-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pdf-container {
    width: 100%;
    max-height: 70vh;
    background: #475569;
  }

  .pdf-object {
    display: block;
    border: none;
  }

  .pdf-fallback {
    padding: 2rem 1rem;
    background-color: var(--bg-surface);
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .pdf-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .pdf-actions {
      width: 100%;
    }
    .pdf-actions .btn {
      flex: 1;
    }
  }
</style>
