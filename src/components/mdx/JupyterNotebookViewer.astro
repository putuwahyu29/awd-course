---
import fs from 'node:fs';
import path from 'node:path';
import { Code } from 'astro:components';

interface Props {
  notebookPath?: string;
  title?: string;
  colabUrl?: string;
  chapterNotebookPath?: string;
  chapterColabUrl?: string;
  chapterTitle?: string;
  maxCells?: number;
}

const {
  notebookPath = 'public/notebooks/dasar-pemrograman-python.ipynb',
  title = 'Dasar-Dasar Pemrograman Python',
  colabUrl = 'https://colab.research.google.com',
  chapterNotebookPath: propChapterNbPath,
  chapterColabUrl: propChapterColabUrl,
  chapterTitle: propChapterTitle,
  maxCells,
} = Astro.props;

// Read and parse the .ipynb file
let notebookData: { cells: any[] } = { cells: [] };
let downloadUrl = '/notebooks/dasar-pemrograman-python.ipynb';

try {
  const fullPath = path.resolve(process.cwd(), notebookPath);
  if (fs.existsSync(fullPath)) {
    const raw = fs.readFileSync(fullPath, 'utf-8');
    notebookData = JSON.parse(raw);
    downloadUrl = '/' + notebookPath.replace(/^public\//, '');
  }
} catch (err) {
  console.error('Failed to load notebook:', err);
}

let cells = notebookData.cells || [];
if (maxCells && maxCells > 0) {
  cells = cells.slice(0, maxCells);
}

// Compute direct GitHub and Google Colab URLs
const cleanRelPath = notebookPath.replace(/^[./\\]+/, '').replace(/^public[/\\]/, 'public/');
const githubBlobUrl = `https://github.com/putuwahyu29/awd-course/blob/main/${cleanRelPath}`;
const directColabUrl = `https://colab.research.google.com/github/putuwahyu29/awd-course/blob/main/${cleanRelPath}`;
const resolvedColabUrl = (colabUrl && colabUrl !== 'https://colab.research.google.com') 
  ? colabUrl 
  : directColabUrl;

// Auto-detect corresponding full chapter notebook if inside a subfolder
const CHAPTER_NOTEBOOK_MAPPINGS: Record<string, { notebookPath: string; title: string }> = {
  'bab-1-dasar-python': {
    notebookPath: 'public/notebooks/python-data-science/bab-1-dasar-pemrograman-python-lengkap.ipynb',
    title: 'Bab 1 Lengkap',
  },
  'bab-2-package-python': {
    notebookPath: 'public/notebooks/python-data-science/bab-2-package-data-science-lengkap.ipynb',
    title: 'Bab 2 Lengkap',
  },
  'bab-3-analisis-data-eksploratif': {
    notebookPath: 'public/notebooks/python-data-science/bab-3-analisis-data-eksploratif-lengkap.ipynb',
    title: 'Bab 3 Lengkap',
  },
};

let detectedChapterNbPath = propChapterNbPath || '';
let detectedChapterTitle = propChapterTitle || '';

if (!detectedChapterNbPath) {
  for (const [key, val] of Object.entries(CHAPTER_NOTEBOOK_MAPPINGS)) {
    if (notebookPath.includes(key)) {
      detectedChapterNbPath = val.notebookPath;
      if (!detectedChapterTitle) detectedChapterTitle = val.title;
      break;
    }
  }
}

let hasChapterNotebook = false;
let resolvedChapterColabUrl = propChapterColabUrl || '';

if (detectedChapterNbPath && !notebookPath.endsWith('-lengkap.ipynb')) {
  try {
    const fullChapterPath = path.resolve(process.cwd(), detectedChapterNbPath);
    if (fs.existsSync(fullChapterPath)) {
      hasChapterNotebook = true;
      if (!resolvedChapterColabUrl) {
        const cleanChapterRelPath = detectedChapterNbPath.replace(/^[./\\]+/, '').replace(/^public[/\\]/, 'public/');
        resolvedChapterColabUrl = `https://colab.research.google.com/github/putuwahyu29/awd-course/blob/main/${cleanChapterRelPath}`;
      }
    }
  } catch (err) {
    // ignore
  }
}

const viewerId = `nb-viewer-${Math.random().toString(36).substring(2, 9)}`;

function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

// Convert markdown text to clean HTML
function parseMarkdownContent(source: string[] | string): string {
  const text = Array.isArray(source) ? source.join('') : source || '';
  const lines = text.split('\n');
  const htmlParts: string[] = [];

  let inList = false;
  let inOrderedList = false;
  let inTable = false;
  let tableRows: string[] = [];
  let inCodeBlock = false;
  let codeBlockLang = '';
  let codeBlockLines: string[] = [];
  let inBlockquote = false;
  let blockquoteLines: string[] = [];

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function flushList() {
    if (inList) {
      htmlParts.push('</ul>');
      inList = false;
    }
    if (inOrderedList) {
      htmlParts.push('</ol>');
      inOrderedList = false;
    }
  }

  function flushTable() {
    if (inTable && tableRows.length > 0) {
      let tableHtml = '<div class="table-container"><table class="nb-table">';
      tableRows.forEach((row, rIdx) => {
        const cols = row.split('|').filter((_, idx, arr) => idx > 0 && idx < arr.length - 1);
        if (cols.length === 0) return;
        
        // Skip separator row |---|---|
        if (cols.every(c => c.trim().match(/^:?-+:?$/))) return;

        if (rIdx === 0) {
          tableHtml += '<thead><tr>' + cols.map(c => `<th>${formatInline(c.trim())}</th>`).join('') + '</tr></thead><tbody>';
        } else {
          tableHtml += '<tr>' + cols.map(c => `<td>${formatInline(c.trim())}</td>`).join('') + '</tr>';
        }
      });
      tableHtml += '</tbody></table></div>';
      htmlParts.push(tableHtml);
      tableRows = [];
      inTable = false;
    }
  }

  function flushCodeBlock() {
    if (inCodeBlock) {
      const lang = codeBlockLang || 'text';
      // Normalize common leading whitespace if indented inside markdown lists
      let minIndent = Infinity;
      for (const cl of codeBlockLines) {
        if (cl.trim().length === 0) continue;
        const indentMatch = cl.match(/^(\s*)/);
        const indentLen = indentMatch ? indentMatch[1].length : 0;
        if (indentLen < minIndent) minIndent = indentLen;
      }
      const cleanedLines = minIndent > 0 && minIndent !== Infinity
        ? codeBlockLines.map(cl => cl.length >= minIndent ? cl.slice(minIndent) : cl.trimStart())
        : codeBlockLines;

      const codeText = cleanedLines.join('\n');
      htmlParts.push(
        `<pre data-language="${escapeHtml(lang)}" class="language-${escapeHtml(lang)}"><code class="language-${escapeHtml(lang)}">${escapeHtml(codeText)}</code></pre>`
      );
      codeBlockLines = [];
      codeBlockLang = '';
      inCodeBlock = false;
    }
  }

  function flushBlockquote() {
    if (inBlockquote && blockquoteLines.length > 0) {
      htmlParts.push(
        `<blockquote class="nb-callout">` +
          blockquoteLines.map(l => `<p class="nb-callout-text">${formatInline(l)}</p>`).join('') +
        `</blockquote>`
      );
      blockquoteLines = [];
      inBlockquote = false;
    }
  }

  function flushAll() {
    flushList();
    flushTable();
    flushBlockquote();
  }

  function cleanLatexFormula(str: string): string {
    return str
      .replace(/\\text\{([^}]+)\}/g, '$1')
      .replace(/\\mathbf\{([^}]+)\}/g, '<strong>$1</strong>')
      .replace(/\\mathit\{([^}]+)\}/g, '<em>$1</em>')
      .replace(/\\_/g, '_')
      .replace(/\\\s+/g, ' ')
      .replace(/\\times/g, ' × ')
      .replace(/\\cdot/g, ' · ')
      .replace(/\\pm/g, ' ± ')
      .replace(/\\le/g, ' ≤ ')
      .replace(/\\ge/g, ' ≥ ')
      .replace(/\\ne/g, ' ≠ ')
      .replace(/\\approx/g, ' ≈ ')
      .replace(/\\sqrt\{([^}]+)\}/g, '√($1)')
      .replace(/\\frac\{([^}]+)\}\{([^}]+)\}/g, '($1 / $2)');
  }

  function formatInline(str: string): string {
    const formatted = str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.*?)\*/g, '<em>$1</em>')
      .replace(/`([^`]+)`/g, '<code class="nb-code-inline">$1</code>')
      .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="nb-link">$1</a>');

    // Inline math $...$
    return formatted.replace(/\$([^\$\n]+)\$/g, (_, expr) => {
      const clean = cleanLatexFormula(expr);
      return `<code class="nb-math-inline">${clean}</code>`;
    });
  }

  for (let i = 0; i < lines.length; i++) {
    const rawLine = lines[i];
    const line = rawLine.trim();

    // Math block $$...$$
    if (line.startsWith('$$') && line.endsWith('$$') && line.length >= 4) {
      flushAll();
      const mathExpr = line.slice(2, -2).trim();
      const cleanExpr = cleanLatexFormula(mathExpr);
      htmlParts.push(
        `<div class="nb-math-block" title="Notasi Matematika / Sintaksis"><span class="nb-math-display">${cleanExpr}</span></div>`
      );
      continue;
    }

    // Fenced code blocks ```
    if (line.startsWith('```')) {
      if (inCodeBlock) {
        flushCodeBlock();
      } else {
        flushAll();
        inCodeBlock = true;
        codeBlockLang = line.slice(3).trim();
        codeBlockLines = [];
      }
      continue;
    }

    if (inCodeBlock) {
      codeBlockLines.push(rawLine);
      continue;
    }

    // Blockquote >
    if (line.startsWith('>')) {
      flushList();
      flushTable();
      inBlockquote = true;
      blockquoteLines.push(line.replace(/^>\s?/, ''));
      continue;
    } else {
      flushBlockquote();
    }

    // Table line
    if (line.startsWith('|') && line.endsWith('|')) {
      flushList();
      inTable = true;
      tableRows.push(line);
      continue;
    } else {
      flushTable();
    }

    // Horizontal Rule
    if (/^(?:---|\*\*\*|___)$/.test(line)) {
      flushList();
      htmlParts.push('<hr class="nb-divider" />');
      continue;
    }

    // Headings
    const h1Match = line.match(/^#\s+(.+)$/);
    if (h1Match) {
      flushList();
      const slug = slugify(h1Match[1]);
      htmlParts.push(`<h2 id="${slug}" class="nb-heading-1"><a href="#${slug}" class="heading-anchor">${formatInline(h1Match[1])}</a></h2>`);
      continue;
    }

    const h2Match = line.match(/^##\s+(.+)$/);
    if (h2Match) {
      flushList();
      const slug = slugify(h2Match[1]);
      htmlParts.push(`<h2 id="${slug}" class="nb-heading-2"><a href="#${slug}" class="heading-anchor">${formatInline(h2Match[1])}</a></h2>`);
      continue;
    }

    const h3Match = line.match(/^###\s+(.+)$/);
    if (h3Match) {
      flushList();
      const slug = slugify(h3Match[1]);
      htmlParts.push(`<h3 id="${slug}" class="nb-heading-3"><a href="#${slug}" class="heading-anchor">${formatInline(h3Match[1])}</a></h3>`);
      continue;
    }

    const h4Match = line.match(/^####\s+(.+)$/);
    if (h4Match) {
      flushList();
      const slug = slugify(h4Match[1]);
      htmlParts.push(`<h4 id="${slug}" class="nb-heading-4"><a href="#${slug}" class="heading-anchor">${formatInline(h4Match[1])}</a></h4>`);
      continue;
    }

    // Ordered List
    const orderedListMatch = line.match(/^(\d+)\.\s+(.+)$/);
    if (orderedListMatch) {
      if (inList) {
        htmlParts.push('</ul>');
        inList = false;
      }
      if (!inOrderedList) {
        htmlParts.push('<ol class="nb-ordered-list">');
        inOrderedList = true;
      }
      htmlParts.push(`<li>${formatInline(orderedListMatch[2])}</li>`);
      continue;
    }

    // Bullet List
    const listMatch = line.match(/^[\*\-]\s+(.+)$/);
    if (listMatch) {
      if (inOrderedList) {
        htmlParts.push('</ol>');
        inOrderedList = false;
      }
      if (!inList) {
        htmlParts.push('<ul class="nb-list">');
        inList = true;
      }
      htmlParts.push(`<li>${formatInline(listMatch[1])}</li>`);
      continue;
    } else {
      flushList();
    }

    // Empty line
    if (line === '') {
      continue;
    }

    // Standard Paragraph
    htmlParts.push(`<p class="nb-paragraph">${formatInline(rawLine)}</p>`);
  }

  flushAll();
  flushCodeBlock();

  return htmlParts.join('\n');
}

function getCodeSource(source: string[] | string): string {
  return Array.isArray(source) ? source.join('') : source;
}

interface ParsedOutputItem {
  type: 'text' | 'html' | 'image' | 'error';
  content: string;
}

function parseCellOutputs(outputs: any[]): { items: ParsedOutputItem[]; textCombined: string } {
  if (!outputs || !Array.isArray(outputs)) return { items: [], textCombined: '' };
  const items: ParsedOutputItem[] = [];
  let textCombined = '';

  for (const o of outputs) {
    if (o.output_type === 'stream' && o.text) {
      const text = Array.isArray(o.text) ? o.text.join('') : String(o.text);
      if (text.trim()) {
        items.push({ type: 'text', content: text });
        textCombined += text;
      }
    } else if (o.output_type === 'execute_result' || o.output_type === 'display_data') {
      const data = o.data || {};
      if (data['image/png']) {
        const rawImg = Array.isArray(data['image/png']) ? data['image/png'].join('') : String(data['image/png']);
        items.push({ type: 'image', content: `data:image/png;base64,${rawImg.trim()}` });
      } else if (data['image/jpeg']) {
        const rawImg = Array.isArray(data['image/jpeg']) ? data['image/jpeg'].join('') : String(data['image/jpeg']);
        items.push({ type: 'image', content: `data:image/jpeg;base64,${rawImg.trim()}` });
      } else if (data['text/html']) {
        const html = Array.isArray(data['text/html']) ? data['text/html'].join('') : String(data['text/html']);
        items.push({ type: 'html', content: html });
      } else if (data['text/plain']) {
        const plain = Array.isArray(data['text/plain']) ? data['text/plain'].join('') : String(data['text/plain']);
        // Don't add plain text if it's just <Figure size...> when we already have an image
        if (plain.trim() && !plain.includes('<Figure size') && !plain.includes('<Axes:')) {
          items.push({ type: 'text', content: plain });
          textCombined += (textCombined ? '\n' : '') + plain;
        }
      }
    } else if (o.output_type === 'error') {
      const evalue = o.evalue || 'Terjadi kesalahan pada baris sel.';
      items.push({ type: 'error', content: `Error: ${evalue}` });
      textCombined += (textCombined ? '\n' : '') + `Error: ${evalue}`;
    }
  }

  return { items, textCombined: textCombined.trim() };
}

const isRunnerEnabled = import.meta.env.PUBLIC_ENABLE_CODE_RUNNER === 'true';
---


<div class="notebook-container" id={viewerId} data-runner-enabled={isRunnerEnabled ? 'true' : 'false'}>
  <!-- Quick Actions Bar -->
  <div class="notebook-header-card card">
    <div class="header-left">
      <div class="notebook-icon-box" title="Notebook Python 3">
        <!-- Official Python Logo -->
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="#3776AB" d="M11.914 2c-5.074 0-4.75 2.2-4.75 2.2l.008 2.281h4.82v.688H5.16s-3.16.355-3.16 5.48c0 5.125 2.762 4.938 2.762 4.938h1.652v-2.313s-.09-2.762 2.719-2.762h4.672s2.625.043 2.625-2.582V4.582S16.988 2 11.914 2zm-2.6 1.48a.98.98 0 1 1 0 1.96.98.98 0 0 1 0-1.96z"/>
          <path fill="#FFD43B" d="M12.086 22c5.074 0 4.75-2.2 4.75-2.2l-.008-2.281H12v-.688h6.832s3.16-.355 3.16-5.48c0-5.125-2.762-4.938-2.762-4.938h-1.652v2.313s.09 2.762-2.719 2.762H10.2s-2.625-.043-2.625 2.582v4.207S7.012 22 12.086 22zm2.6-1.48a.98.98 0 1 1 0-1.96.98.98 0 0 1 0 1.96z"/>
        </svg>
      </div>
      <div class="header-info">
        <h3 class="header-title">{title}</h3>
        <span class="header-status">
          {cells.length} Sel • {isRunnerEnabled ? 'Python 3 (WebAssembly Kernel)' : 'Python 3 • Pratinjau Notebook'}
        </span>
      </div>
    </div>

    <div class="header-actions">
      {isRunnerEnabled && (
        <button type="button" class="nb-action-btn btn-run-all run-all-cells-btn" title="Jalankan Semua Sel Kode Python">
          <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span class="btn-label-desktop">Jalankan Semua</span>
          <span class="btn-label-mobile">Jalankan</span>
        </button>
      )}

      <a href={downloadUrl} download class="nb-action-btn btn-download" title="Unduh File Notebook .ipynb">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span class="btn-label-desktop">Unduh .ipynb</span>
        <span class="btn-label-mobile">Unduh</span>
      </a>

      <a href={githubBlobUrl} target="_blank" rel="noopener noreferrer" class="nb-action-btn btn-github" title="Buka File Notebook di GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span>GitHub</span>
      </a>

      <a href={resolvedColabUrl} target="_blank" rel="noopener noreferrer" class="nb-action-btn btn-colab" title="Buka materi ini di Google Colab">
        <!-- Official Google Colab Logo -->
        <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" class="colab-icon-svg">
          <path fill="#F9AB00" d="M16.9414 4.9757a7.033 7.033 0 0 0-4.9308 2.0646 7.033 7.033 0 0 0-.1232 9.8068l2.395-2.395a3.6455 3.6455 0 0 1 5.1497-5.1478l2.397-2.3989a7.033 7.033 0 0 0-4.8877-1.9297zM7.07 4.9855a7.033 7.033 0 0 0-4.8878 1.9316l2.3911 2.3911a3.6434 3.6434 0 0 1 5.0227.1271l1.7341-2.9737-.0997-.0802A7.033 7.033 0 0 0 7.07 4.9855zm15.0093 2.1721l-2.3892 2.3911a3.6455 3.6455 0 0 1-5.1497 5.1497l-2.4067 2.4068a7.0362 7.0362 0 0 0 9.9456-9.9476zM1.932 7.1674a7.033 7.033 0 0 0-.002 9.6816l2.397-2.397a3.6434 3.6434 0 0 1-.004-4.8916zm7.664 7.4235c-1.38 1.3816-3.5863 1.411-5.0168.1134l-2.397 2.395c2.4693 2.3328 6.263 2.5753 9.0072.5455l.1368-.1115z"/>
        </svg>
        <span class="btn-label-desktop">Buka di Colab</span>
        <span class="btn-label-mobile">Colab</span>
      </a>
    </div>
  </div>

  <!-- Document Flow Stream (Clean Textbook Layout) -->
  <div class="notebook-content-flow">
    {cells.map((cell, idx) => {
      if (cell.cell_type === 'markdown') {
        return (
          <div class="markdown-block" set:html={parseMarkdownContent(cell.source || '')} />
        );
      } else if (cell.cell_type === 'code') {
        const codeText = getCodeSource(cell.source || '');
        if (!codeText.trim()) return null;

        const { items: parsedOutputs, textCombined: initialOut } = parseCellOutputs(cell.outputs || []);
        const hasRichOutput = parsedOutputs.some((item) => item.type === 'image' || item.type === 'html');
        const hasAnyOutput = parsedOutputs.length > 0;
        const lines = codeText.split('\n');
        const rowCount = Math.min(Math.max(lines.length, 1), 25);

        return (
          <div class="code-cell-container card" data-cell-index={idx} data-code={codeText}>
            <!-- Code Bar Top -->
            <div class="code-cell-topbar">
              <div class="topbar-left">
                <span class="cell-index-badge">In [{idx + 1}]:</span>
                <span class="lang-tag">python</span>
              </div>

              <div class="topbar-right">
                <button type="button" class="btn-ai-explain" title="Tanyakan penjelasan kode ke AI">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
                    <circle cx="12" cy="12" r="4"></circle>
                  </svg>
                  <span>Tanya AI</span>
                </button>

                <button type="button" class="btn-copy-code" title="Salin Kode">
                  <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Salin</span>
                </button>

                {isRunnerEnabled && (
                  <button type="button" class="btn-run-code" title="Jalankan Sel Kode Ini">
                    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" width="12" height="12">
                      <polygon points="6 4 20 12 6 20 6 4"></polygon>
                    </svg>
                    <div class="spin-loader hidden"></div>
                    <span class="run-label">Jalankan</span>
                  </button>
                )}
              </div>
            </div>

            <!-- Code Editor Area -->
            <div class="code-editor-wrapper">
              <div class="line-numbers" aria-hidden="true">
                {lines.map((_, lIdx) => (
                  <span>{lIdx + 1}</span>
                ))}
              </div>
              {isRunnerEnabled ? (
                <textarea
                  class="code-input"
                  spellcheck="false"
                  rows={rowCount}
                >{codeText}</textarea>
              ) : (
                <div class="code-shiki-container">
                  <Code code={codeText} lang="python" themes={{ light: 'github-light', dark: 'one-dark-pro' }} wrap={false} />
                </div>
              )}
            </div>

            <!-- Execution Output Box -->
            <div class={`code-output-wrapper ${hasAnyOutput ? '' : 'hidden'}`}>
              <div class="output-topbar">
                <span class="output-badge">Out [{idx + 1}]:</span>
                <button type="button" class="btn-clear-out" title="Bersihkan Output">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                </button>
              </div>

              {hasRichOutput && (
                <div class="output-rich-content">
                  {parsedOutputs.map((item) => {
                    if (item.type === 'image') {
                      return (
                        <div class="output-image-card">
                          <img src={item.content} alt={`Grafik Visualisasi Out [${idx + 1}]`} class="nb-output-img" loading="lazy" />
                        </div>
                      );
                    } else if (item.type === 'html') {
                      return (
                        <div class="output-html-card table-container" set:html={item.content} />
                      );
                    }
                    return null;
                  })}
                </div>
              )}

              <pre class={`output-console ${initialOut ? '' : (hasRichOutput ? 'hidden' : '')}`}><code>{initialOut}</code></pre>
            </div>
          </div>
        );
      }
    })}
  </div>
</div>

<script>
  let pyodidePromiseInstance: Promise<any> | null = null;

  function getSharedPyodide(onStatus?: (status: string) => void) {
    if (!pyodidePromiseInstance) {
      pyodidePromiseInstance = new Promise(async (resolve, reject) => {
        try {
          if (onStatus) onStatus('Mengunduh runtime Python WebAssembly (~15 MB)...');
          // @ts-ignore
          if (!window.loadPyodide) {
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/pyodide.js';
            document.head.appendChild(s);
            await new Promise((res) => (s.onload = res));
          }
          if (onStatus) onStatus('Menginisialisasi kernel Python di browser...');
          // @ts-ignore
          const py = await window.loadPyodide({
            indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/',
          });

          resolve(py);
        } catch (e) {
          pyodidePromiseInstance = null; // allow retry if network error
          reject(e);
        }
      });
    }
    return pyodidePromiseInstance;
  }

  function setupNotebookRunner() {
    document.querySelectorAll('.notebook-container').forEach((nb) => {
      const isRunnerEnabled = nb.getAttribute('data-runner-enabled') === 'true';

      // Attach copy & clear handlers to code cells
      nb.querySelectorAll('.code-cell-container').forEach((cell) => {
        const copyBtn = cell.querySelector('.btn-copy-code');
        const clearBtn = cell.querySelector('.btn-clear-out');
        const textarea = cell.querySelector('.code-input') as HTMLTextAreaElement;
        const outWrapper = cell.querySelector('.code-output-wrapper');
        const outCode = cell.querySelector('.output-console code');

        copyBtn?.addEventListener('click', () => {
          const rawCode = cell.getAttribute('data-code') || textarea?.value || '';
          if (!rawCode) return;
          navigator.clipboard.writeText(rawCode);
          const originalText = copyBtn.querySelector('span')?.textContent;
          if (copyBtn.querySelector('span')) {
            copyBtn.querySelector('span')!.textContent = 'Tersalin!';
            setTimeout(() => {
              copyBtn.querySelector('span')!.textContent = originalText || 'Salin';
            }, 1500);
          }
        });

        clearBtn?.addEventListener('click', () => {
          if (outCode) outCode.textContent = '';
          const rich = cell.querySelector('.output-rich-content');
          if (rich) rich.classList.add('hidden');
          outWrapper?.classList.add('hidden');
        });
      });

      // Attach copy handlers to fenced code blocks inside markdown
      nb.querySelectorAll('.nb-fenced-copy-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const box = btn.closest('.nb-fenced-code-box');
          const code = box?.querySelector('code')?.textContent || '';
          if (!code) return;
          navigator.clipboard.writeText(code);
          const originalText = btn.querySelector('span')?.textContent;
          if (btn.querySelector('span')) {
            btn.querySelector('span')!.textContent = 'Tersalin!';
            setTimeout(() => {
              btn.querySelector('span')!.textContent = originalText || 'Salin';
            }, 1500);
          }
        });
      });

      if (!isRunnerEnabled) return;

      const runAllBtn = nb.querySelector('.run-all-cells-btn');

      async function runCell(cell: Element) {
        const runBtn = cell.querySelector('.btn-run-code') as HTMLButtonElement;
        const playIcon = cell.querySelector('.icon-play');
        const spinner = cell.querySelector('.spin-loader');
        const runLabel = cell.querySelector('.run-label');
        const textarea = cell.querySelector('.code-input') as HTMLTextAreaElement;
        const outWrapper = cell.querySelector('.code-output-wrapper');
        const outConsole = cell.querySelector('.output-console');
        const outCode = cell.querySelector('.output-console code');

        if (!textarea || !outCode) return;

        playIcon?.classList.add('hidden');
        spinner?.classList.remove('hidden');
        if (runLabel) runLabel.textContent = 'Memproses...';
        if (runBtn) runBtn.disabled = true;

        outWrapper?.classList.remove('hidden');
        const rich = cell.querySelector('.output-rich-content');
        if (rich) rich.classList.add('hidden');
        outConsole?.classList.remove('hidden');
        outCode.textContent = 'Menyiapkan lingkungan eksekusi...';

        try {
          const py = await getSharedPyodide((statusMsg) => {
            outCode.textContent = statusMsg;
          });
          outCode.textContent = '';

          let logs = '';
          py.setStdout({ batched: (m: string) => { logs += m + '\n'; } });
          py.setStderr({ batched: (m: string) => { logs += 'Error: ' + m + '\n'; } });

          const rawCode = textarea.value;
          const lines = rawCode.split('\n');
          const filteredLines: string[] = [];
          const packagesToInstall: string[] = [];

          for (const line of lines) {
            const trimmed = line.trim();
            // Detect !pip install, ! pip install, %pip install, pip install
            const pipMatch = trimmed.match(/^(!\s*pip|%\s*pip|pip)\s+install\s+(.+)$/i);
            if (pipMatch) {
              const pkgArgs = pipMatch[2].split(/\s+/).filter((p) => p && !p.startsWith('-'));
              packagesToInstall.push(...pkgArgs);
            } else {
              filteredLines.push(line);
            }
          }

          // Auto-detect common libraries if imported directly
          const importMatches = Array.from(rawCode.matchAll(/(?:from|import)\s+([a-zA-Z0-9_]+)/g));
          for (const match of importMatches) {
            const mod = match[1];
            if (['numpy', 'pandas', 'matplotlib', 'seaborn', 'scipy', 'sklearn', 'requests'].includes(mod)) {
              if (!packagesToInstall.includes(mod)) {
                packagesToInstall.push(mod);
              }
            }
          }

          // Load requested packages in Pyodide
          if (packagesToInstall.length > 0) {
            for (const pkg of packagesToInstall) {
              outCode.textContent = `Memuat paket '${pkg}' ke WebAssembly kernel...`;
              try {
                await py.loadPackage(pkg);
              } catch {
                try {
                  await py.loadPackage('micropip');
                  const micropip = py.pyimport('micropip');
                  await micropip.install(pkg);
                } catch (micropipErr: any) {
                  logs += `[Informasi Paket ${pkg}]: ${micropipErr.message || micropipErr}\n`;
                }
              }
            }
            outCode.textContent = '';
          }

          const cleanCode = filteredLines.join('\n').trim();
          let result: any = undefined;

          if (cleanCode) {
            result = await py.runPythonAsync(cleanCode);
          } else if (packagesToInstall.length > 0) {
            logs = `Paket berhasil dimuat: ${packagesToInstall.join(', ')}`;
          }

          if (logs) {
            outCode.textContent = logs.trim();
          } else if (result !== undefined) {
            outCode.textContent = String(result);
          } else {
            outCode.textContent = '[Kode berhasil dieksekusi tanpa keluaran]';
          }
        } catch (err: any) {
          console.error('Notebook cell execution error:', err);
          const errStr = String(err?.message || err || '').toLowerCase();
          if (
            errStr.includes('fetch') ||
            errStr.includes('network') ||
            errStr.includes('cdn') ||
            errStr.includes('script') ||
            errStr.includes('failed to load')
          ) {
            outCode.textContent =
              'Gagal memuat pustaka Python dari server CDN. Pastikan koneksi internet Anda stabil, atau gunakan tombol "Buka di Colab" di atas untuk menjalankan notebook langsung di Google Colab.';
          } else {
            outCode.textContent = `Pesan Kesalahan Kode:\n${err.message || err}`;
          }
        } finally {
          playIcon?.classList.remove('hidden');
          spinner?.classList.add('hidden');
          if (runLabel) runLabel.textContent = 'Jalankan';
          if (runBtn) runBtn.disabled = false;
        }
      }

      // Attach handlers to code cells (Run, Copy, Tanya AI)
      nb.querySelectorAll('.code-cell-container').forEach((cell) => {
        const runBtn = cell.querySelector('.btn-run-code');
        const textareaEl = cell.querySelector('.code-input') as HTMLTextAreaElement;

        const triggerRun = () => {
          if (typeof (window as any).awdConfirmPythonRun === 'function') {
            (window as any).awdConfirmPythonRun(() => runCell(cell));
          } else {
            runCell(cell);
          }
        };

        runBtn?.addEventListener('click', triggerRun);

        // Ctrl+Enter or Shift+Enter in code input
        textareaEl?.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.shiftKey) && e.key === 'Enter') {
            e.preventDefault();
            triggerRun();
          }
        });

        const copyBtn = cell.querySelector('.btn-copy-code');
        const aiBtn = cell.querySelector('.btn-ai-explain');
        const codeText = cell.getAttribute('data-code') || '';

        copyBtn?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(codeText.trim());
            const origHTML = copyBtn.innerHTML;
            copyBtn.innerHTML = `<span>✓ Tersalin!</span>`;
            (copyBtn as HTMLElement).style.color = '#10b981';
            setTimeout(() => {
              copyBtn.innerHTML = origHTML;
              (copyBtn as HTMLElement).style.color = '';
            }, 2000);
          } catch (e) {
            console.error('Copy failed:', e);
          }
        });

        aiBtn?.addEventListener('click', () => {
          const prompt = `Tolong jelaskan potongan kode Python dari notebook pembelajaran berikut secara rinci, terstruktur, baris per baris beserta fungsinya:\n\n\`\`\`python\n${codeText.trim()}\n\`\`\``;
          if (typeof (window as any).openAwdChatWithPrompt === 'function') {
            (window as any).openAwdChatWithPrompt(prompt, true);
            return;
          }
          // Fallback event dispatch
          window.dispatchEvent(new CustomEvent('awd:open-chat', { detail: { prompt, autoSubmit: true } }));

          // Fallback direct DOM
          const modal = document.getElementById('awd-chat-modal');
          const backdrop = document.getElementById('awd-chat-backdrop');
          const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
          const sendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement | null;
          const form = document.getElementById('chat-form') as HTMLFormElement | null;

          if (modal) {
            modal.classList.remove('hidden');
            if (backdrop) backdrop.classList.remove('hidden');
            document.body.classList.add('awd-chat-open');
          }
          if (input) {
            input.value = prompt;
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 120) + 'px';
          }
          setTimeout(() => {
            if (sendBtn && !sendBtn.disabled) {
              sendBtn.click();
            } else if (form) {
              try {
                form.requestSubmit();
              } catch (err) {
                form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
              }
            }
          }, 150);
        });
      });

      // Run All button
      runAllBtn?.addEventListener('click', () => {
        const executeAll = async () => {
          const codeCells = Array.from(nb.querySelectorAll('.code-cell-container'));
          for (const c of codeCells) {
            await runCell(c);
          }
        };

        if (typeof (window as any).awdConfirmPythonRun === 'function') {
          (window as any).awdConfirmPythonRun(executeAll);
        } else {
          executeAll();
        }
      });
    });
  }

  setupNotebookRunner();
  document.addEventListener('astro:page-load', setupNotebookRunner);
</script>

