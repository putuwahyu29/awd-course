---
// src/components/SearchModal.astro
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');

const publishedCourses = allCourses.filter(
  (c) => c.data.isPublished && c.data.status !== 'draft'
);
const publishedCourseIds = new Set(publishedCourses.map((c) => c.id));

// Filter strictly published lessons
const searchableLessons = allLessons
  .filter((l) => publishedCourseIds.has(l.data.courseSlug) && l.data.isPublished !== false)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .map((l) => {
    const course = publishedCourses.find((c) => c.id === l.data.courseSlug);
    return {
      id: l.id,
      title: l.data.title,
      chapter: l.data.chapter || 'Materi',
      courseSlug: l.data.courseSlug,
      courseTitle: course?.data.title || 'Kursus',
      duration: l.data.duration || '10 Menit',
      contentType: l.data.contentType || 'text',
      url: `/courses/${l.data.courseSlug}/${l.id}`,
    };
  });
---

<!-- Search Modal Overlay -->
<div id="global-search-overlay" class="search-overlay hidden" aria-hidden="true">
  <div class="search-backdrop" id="search-backdrop"></div>

  <div class="search-modal" role="dialog" aria-modal="true" aria-label="Pencarian Materi Pembelajaran">
    <!-- Search Input Header -->
    <div class="search-header">
      <svg class="search-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="text"
        id="search-dialog-input"
        class="search-dialog-input"
        placeholder="Cari materi pembelajaran, topik, atau sintaksis..."
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" id="search-close-btn" class="search-esc-badge" title="Tutup (Esc)">
        <span>ESC</span>
      </button>
    </div>

    <!-- Quick Filter Suggestions -->
    <div class="search-quick-tags">
      <span class="quick-tag-label">Topik Cepat:</span>
      <button type="button" class="quick-tag-btn" data-query="Python">Dasar Python</button>
      <button type="button" class="quick-tag-btn" data-query="NumPy">NumPy</button>
      <button type="button" class="quick-tag-btn" data-query="Pandas">Pandas</button>
      <button type="button" class="quick-tag-btn" data-query="Matplotlib">Visualisasi Data</button>
      <button type="button" class="quick-tag-btn" data-query="Fungsi">Fungsi</button>
      <button type="button" class="quick-tag-btn" data-query="Loop">Perulangan</button>
    </div>

    <!-- Results List -->
    <div class="search-results-wrap">
      <ul id="search-results-list" class="search-results-list">
        <!-- Injected via client JS -->
      </ul>

      <!-- Empty State -->
      <div id="search-empty-state" class="search-empty-box hidden">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="32" height="32" class="empty-icon">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <p class="empty-text">Tidak ada materi yang cocok dengan pencarian Anda.</p>
        <p class="empty-subtext">Coba kata kunci lain seperti <em>variabel</em>, <em>loop</em>, atau <em>analisis data</em>.</p>
      </div>
    </div>

    <!-- Footer Shortcuts Info -->
    <div class="search-footer">
      <div class="shortcut-tip">
        <kbd>&uarr;</kbd> <kbd>&darr;</kbd>
        <span>Navigasi</span>
      </div>
      <div class="shortcut-tip">
        <kbd>&crarr;</kbd>
        <span>Buka</span>
      </div>
      <div class="shortcut-tip">
        <kbd>Esc</kbd>
        <span>Tutup</span>
      </div>
      <div class="search-total-count">
        <span>{searchableLessons.length} Materi Tersedia</span>
      </div>
    </div>
  </div>
</div>

<!-- Embedded Search Data -->
<script is:inline id="search-data-payload" type="application/json" set:html={JSON.stringify(searchableLessons)} />

<script>
  function initGlobalSearch() {
    const overlay = document.getElementById('global-search-overlay');
    const backdrop = document.getElementById('search-backdrop');
    const closeBtn = document.getElementById('search-close-btn');
    const input = document.getElementById('search-dialog-input') as HTMLInputElement | null;
    const resultsList = document.getElementById('search-results-list');
    const emptyState = document.getElementById('search-empty-state');
    const quickTags = document.querySelectorAll<HTMLButtonElement>('.quick-tag-btn');
    const triggerBtns = document.querySelectorAll('.trigger-global-search');

    if (!overlay || !input || !resultsList) return;

    let items: Array<{
      id: string;
      title: string;
      chapter: string;
      courseSlug: string;
      courseTitle: string;
      duration: string;
      contentType: string;
      url: string;
    }> = [];

    const payloadEl = document.getElementById('search-data-payload');
    if (payloadEl && payloadEl.textContent) {
      try {
        items = JSON.parse(payloadEl.textContent);
      } catch (e) {
        console.error('Failed to parse search data payload:', e);
      }
    }

    let activeIndex = 0;
    let currentResults: typeof items = [];

    function openSearch(initialQuery = '') {
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      if (input) {
        input.value = initialQuery;
        input.focus();
        renderResults(initialQuery);
      }
    }

    function closeSearch() {
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
      if (input) input.value = '';
    }

    function renderResults(query = '') {
      const q = query.toLowerCase().trim();
      if (!q) {
        currentResults = items;
      } else {
        currentResults = items.filter((item) => {
          return (
            item.title.toLowerCase().includes(q) ||
            item.chapter.toLowerCase().includes(q) ||
            item.courseTitle.toLowerCase().includes(q) ||
            item.id.toLowerCase().includes(q)
          );
        });
      }

      activeIndex = 0;
      if (!resultsList) return;
      resultsList.innerHTML = '';

      if (currentResults.length === 0) {
        emptyState?.classList.remove('hidden');
        resultsList.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      resultsList.classList.remove('hidden');

      currentResults.forEach((item, idx) => {
        const li = document.createElement('li');
        li.className = `search-item-row ${idx === 0 ? 'selected' : ''}`;
        li.setAttribute('data-url', item.url);
        li.setAttribute('data-index', String(idx));

        const iconSvg = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>`;

        li.innerHTML = `
          <div class="search-item-left">
            <span class="item-type-icon">${iconSvg}</span>
            <div class="item-text-info">
              <span class="item-title">${item.title}</span>
              <span class="item-chapter">${item.chapter}</span>
            </div>
          </div>
          <div class="search-item-right">
            <span class="item-duration">${item.duration}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" class="arrow-icon">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </div>
        `;

        li.addEventListener('click', () => {
          window.location.href = item.url;
        });

        li.addEventListener('mouseenter', () => {
          updateActiveItem(idx);
        });

        resultsList.appendChild(li);
      });
    }

    function updateActiveItem(newIndex: number) {
      if (currentResults.length === 0) return;
      const allRows = resultsList?.querySelectorAll('.search-item-row');
      if (!allRows) return;

      allRows.forEach((row, i) => {
        if (i === newIndex) {
          row.classList.add('selected');
          row.scrollIntoView({ block: 'nearest' });
        } else {
          row.classList.remove('selected');
        }
      });
      activeIndex = newIndex;
    }

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      // Ctrl + K or Cmd + K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (overlay?.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
        return;
      }

      if (overlay && !overlay.classList.contains('hidden')) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeSearch();
        } else if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (activeIndex < currentResults.length - 1) {
            updateActiveItem(activeIndex + 1);
          }
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (activeIndex > 0) {
            updateActiveItem(activeIndex - 1);
          }
        } else if (e.key === 'Enter') {
          e.preventDefault();
          if (currentResults[activeIndex]) {
            window.location.href = currentResults[activeIndex].url;
          }
        }
      }
    });

    input?.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });

    quickTags.forEach((tag) => {
      tag.addEventListener('click', () => {
        const query = tag.getAttribute('data-query') || '';
        if (input) {
          input.value = query;
          input.focus();
          renderResults(query);
        }
      });
    });

    triggerBtns.forEach((btn) => {
      btn.addEventListener('click', () => openSearch());
    });

    closeBtn?.addEventListener('click', closeSearch);
    backdrop?.addEventListener('click', closeSearch);
  }

  document.addEventListener('astro:page-load', initGlobalSearch);
</script>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 3rem 1rem;
  }

  .search-overlay.hidden {
    display: none !important;
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(11, 15, 25, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeIn 0.15s ease-out;
  }

  .search-modal {
    position: relative;
    width: 100%;
    max-width: 620px;
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl), 0 25px 50px -12px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    animation: slideDown 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .search-input-icon {
    color: var(--primary);
    flex-shrink: 0;
  }

  .search-dialog-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 1.05rem;
    font-family: inherit;
    color: var(--text-main);
  }

  .search-dialog-input::placeholder {
    color: var(--text-subtle);
  }

  .search-esc-badge {
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    color: var(--text-muted);
    font-size: 0.725rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-esc-badge:hover {
    color: var(--text-main);
    border-color: var(--border-focus);
  }

  .search-quick-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .search-quick-tags::-webkit-scrollbar {
    display: none;
  }

  .quick-tag-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-subtle);
    white-space: nowrap;
  }

  .quick-tag-btn {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  .quick-tag-btn:hover {
    color: var(--primary);
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .search-results-wrap {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  .search-results-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  :global(.search-item-row) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    cursor: pointer;
    transition: background 0.12s ease;
    border-left: 3px solid transparent;
  }

  :global(.search-item-row.selected) {
    background: var(--primary-light);
    border-left-color: var(--primary);
  }

  :global(.search-item-left) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  :global(.item-type-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary);
    flex-shrink: 0;
  }

  :global(.item-text-info) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  :global(.item-title) {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--text-main);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.item-chapter) {
    font-size: 0.775rem;
    color: var(--text-subtle);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.search-item-right) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  :global(.item-duration) {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: var(--bg-surface-elevated);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  :global(.arrow-icon) {
    color: var(--text-subtle);
    transition: transform 0.15s ease;
  }

  :global(.search-item-row:hover .arrow-icon),
  :global(.search-item-row.selected .arrow-icon) {
    color: var(--primary);
    transform: translateX(2px);
  }

  .search-empty-box {
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .empty-icon {
    color: var(--text-subtle);
    margin-bottom: 0.75rem;
  }

  .empty-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .empty-subtext {
    font-size: 0.825rem;
    color: var(--text-subtle);
  }

  .search-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.25rem;
    background: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    color: var(--text-subtle);
  }

  .shortcut-tip {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .shortcut-tip kbd {
    background: var(--bg-surface);
    border: 1px solid var(--border-medium);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-main);
  }

  @media (max-width: 640px) {
    .search-overlay {
      padding: 1rem;
    }
    .search-footer .shortcut-tip {
      display: none;
    }
  }
</style>
