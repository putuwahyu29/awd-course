---
// PwaPrompt.astro - Komponen UI PWA Native (Install Prompt, Update Notifier, Online/Offline status)
---

<div id="pwa-container" aria-live="polite">
  <!-- PWA Install Banner (Native Feel) -->
  <div id="pwa-install-banner" class="pwa-card hidden" role="dialog" aria-labelledby="pwa-title" aria-describedby="pwa-desc">
    <div class="pwa-header">
      <div class="pwa-app-icon">
        <img src="/icons/icon-96x96.png" alt="Awd Course" width="44" height="44" loading="eager" />
      </div>
      <div class="pwa-text">
        <h3 id="pwa-title">Pasang Awd Course</h3>
        <p id="pwa-desc">Akses modul pembelajaran lebih cepat, hemat kuota, dan tersedia offline.</p>
      </div>
      <button type="button" id="pwa-btn-dismiss" class="pwa-close-btn" aria-label="Tutup saran instalasi">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="pwa-actions">
      <button type="button" id="pwa-btn-later" class="pwa-btn-secondary">Nanti Saja</button>
      <button type="button" id="pwa-btn-install" class="pwa-btn-primary">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" width="16" height="16">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
        <span>Install Aplikasi</span>
      </button>
    </div>
  </div>

  <!-- PWA Update Notification Toast -->
  <div id="pwa-update-toast" class="pwa-toast hidden">
    <div class="pwa-toast-content">
      <div class="pwa-pulse-dot"></div>
      <div class="pwa-toast-text">
        <strong>Pembaruan Tersedia</strong>
        <span>Versi baru materi dan fitur telah siap.</span>
      </div>
      <button type="button" id="pwa-btn-update" class="pwa-btn-update">Perbarui</button>
    </div>
  </div>

  <!-- Online/Offline Connectivity Status Toast -->
  <div id="pwa-status-toast" class="pwa-status hidden">
    <span id="pwa-status-icon" class="status-icon"></span>
    <span id="pwa-status-text">Mode Offline Aktif</span>
  </div>
</div>

<style>
  #pwa-container {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.75rem;
    pointer-events: none;
    max-width: calc(100vw - 2.5rem);
  }

  .hidden {
    display: none !important;
  }

  /* Install Banner */
  .pwa-card {
    pointer-events: auto;
    width: 380px;
    max-width: 100%;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(59, 130, 246, 0.25);
    border-radius: 1rem;
    padding: 1.25rem;
    box-shadow: 0 20px 35px -10px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.05);
    animation: slideUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .pwa-header {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    position: relative;
  }

  .pwa-app-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    background: #1e293b;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .pwa-app-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pwa-text {
    flex: 1;
    min-width: 0;
  }

  .pwa-text h3 {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #f8fafc;
    line-height: 1.3;
  }

  .pwa-text p {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: #94a3b8;
    line-height: 1.4;
  }

  .pwa-close-btn {
    background: transparent;
    border: none;
    color: #64748b;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .pwa-close-btn:hover {
    color: #f1f5f9;
    background: rgba(255, 255, 255, 0.08);
  }

  .pwa-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin-top: 1rem;
  }

  .pwa-btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.45rem 0.85rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pwa-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .pwa-btn-primary {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    color: #ffffff;
    border: none;
    padding: 0.45rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
    transition: all 0.15s ease;
  }

  .pwa-btn-primary:hover {
    background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.5);
    transform: translateY(-1px);
  }

  /* Update Toast */
  .pwa-toast {
    pointer-events: auto;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(59, 130, 246, 0.35);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    animation: slideUp 0.3s ease-out forwards;
  }

  .pwa-toast-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pwa-pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3b82f6;
    box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(59, 130, 246, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(59, 130, 246, 0);
    }
  }

  .pwa-toast-text {
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.3;
  }

  .pwa-toast-text strong {
    color: #ffffff;
    font-size: 0.85rem;
  }

  .pwa-btn-update {
    background: #2563eb;
    color: #ffffff;
    border: none;
    padding: 0.35rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .pwa-btn-update:hover {
    background: #1d4ed8;
  }

  /* Status Toast */
  .pwa-status {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    backdrop-filter: blur(8px);
    animation: fadeIn 0.25s ease forwards;
  }

  .pwa-status.offline {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5;
  }

  .pwa-status.online {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #6ee7b7;
  }

  .status-icon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .pwa-status.offline .status-icon {
    background: #ef4444;
  }

  .pwa-status.online .status-icon {
    background: #10b981;
  }

  @media (max-width: 480px) {
    #pwa-container {
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      max-width: none;
      align-items: stretch;
    }
    .pwa-card {
      width: 100%;
    }
  }
</style>

<script is:inline>
  (function () {
    // Global PWA state
    let deferredPrompt = null;
    let swRegistration = null;

    function isStandaloneMode() {
      return (
        window.matchMedia('(display-mode: standalone)').matches ||
        window.matchMedia('(display-mode: window-controls-overlay)').matches ||
        window.navigator.standalone === true
      );
    }

    function initPwa() {
      const banner = document.getElementById('pwa-install-banner');
      const btnInstall = document.getElementById('pwa-btn-install');
      const btnDismiss = document.getElementById('pwa-btn-dismiss');
      const btnLater = document.getElementById('pwa-btn-later');
      const updateToast = document.getElementById('pwa-update-toast');
      const btnUpdate = document.getElementById('pwa-btn-update');
      const statusToast = document.getElementById('pwa-status-toast');
      const statusText = document.getElementById('pwa-status-text');

      // 1. Service Worker Registration
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker
          .register('/sw.js', { scope: '/' })
          .then((reg) => {
            swRegistration = reg;

            // Check if there is an updated worker waiting
            if (reg.waiting) {
              showUpdateToast();
            }

            reg.addEventListener('updatefound', () => {
              const newWorker = reg.installing;
              if (newWorker) {
                newWorker.addEventListener('statechange', () => {
                  if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    showUpdateToast();
                  }
                });
              }
            });
          })
          .catch((err) => {
            console.warn('[PWA] Service Worker registration failed:', err);
          });

        let refreshing = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (!refreshing) {
            refreshing = true;
            window.location.reload();
          }
        });
      }

      function showUpdateToast() {
        if (updateToast) {
          updateToast.classList.remove('hidden');
        }
      }

      if (btnUpdate) {
        btnUpdate.addEventListener('click', () => {
          if (swRegistration && swRegistration.waiting) {
            swRegistration.waiting.postMessage({ type: 'SKIP_WAITING' });
          }
        });
      }

      // 2. Install Prompt Handling
      function isDismissedRecently() {
        try {
          const dismissedUntil = localStorage.getItem('awd_pwa_dismissed_until');
          if (dismissedUntil && Date.now() < Number(dismissedUntil)) {
            return true;
          }
        } catch (e) {}
        return false;
      }

      function dismissInstallPrompt(days = 7) {
        try {
          localStorage.setItem('awd_pwa_dismissed_until', Date.now() + days * 86400000);
        } catch (e) {}
        if (banner) banner.classList.add('hidden');
      }

      if (btnDismiss) btnDismiss.addEventListener('click', () => dismissInstallPrompt(7));
      if (btnLater) btnLater.addEventListener('click', () => dismissInstallPrompt(3));

      function updateExternalInstallButtons(show) {
        document.querySelectorAll('[data-pwa-install="true"]').forEach((btn) => {
          if (show && !isStandaloneMode()) {
            btn.classList.remove('hidden');
          } else {
            btn.classList.add('hidden');
          }
        });
      }

      async function triggerInstallPrompt() {
        if (!deferredPrompt) return;
        if (banner) banner.classList.add('hidden');
        deferredPrompt.prompt();
        const { outcome } = await deferredPrompt.userChoice;
        if (outcome === 'accepted') {
          try {
            localStorage.removeItem('awd_pwa_dismissed_until');
          } catch (e) {}
          updateExternalInstallButtons(false);
        }
        deferredPrompt = null;
      }

      window.addEventListener('beforeinstallprompt', (e) => {
        // Prevent mini-infobar
        e.preventDefault();
        deferredPrompt = e;

        updateExternalInstallButtons(true);

        // If not in standalone and not dismissed recently, show custom install banner
        if (!isStandaloneMode() && !isDismissedRecently() && banner) {
          banner.classList.remove('hidden');
        }
      });

      if (btnInstall) {
        btnInstall.addEventListener('click', triggerInstallPrompt);
      }

      // Delegate click on any external [data-pwa-install] buttons
      document.addEventListener('click', (e) => {
        const target = e.target.closest('[data-pwa-install="true"]');
        if (target) {
          e.preventDefault();
          triggerInstallPrompt();
        }
      });

      // Update button visibility on init
      if (deferredPrompt) {
        updateExternalInstallButtons(true);
      } else {
        updateExternalInstallButtons(false);
      }

      window.addEventListener('appinstalled', () => {
        if (banner) banner.classList.add('hidden');
        updateExternalInstallButtons(false);
        deferredPrompt = null;
        showStatusNotification('Aplikasi Awd Course berhasil dipasang!', 'online');
      });

      // 3. Connectivity Live Notifier
      function showStatusNotification(message, type = 'offline') {
        if (!statusToast || !statusText) return;
        statusText.textContent = message;
        statusToast.className = `pwa-status ${type}`;
        statusToast.classList.remove('hidden');

        if (type === 'online') {
          setTimeout(() => {
            statusToast.classList.add('hidden');
          }, 3500);
        }
      }

      window.addEventListener('offline', () => {
        showStatusNotification('Mode Offline: Terputus dari internet', 'offline');
      });

      window.addEventListener('online', () => {
        showStatusNotification('Kembali Online: Sinyal internet terhubung', 'online');
      });

      // Check initial state
      if (!navigator.onLine) {
        showStatusNotification('Mode Offline: Terputus dari internet', 'offline');
      }
    }

    // Run on first load and Astro view transitions
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPwa);
    } else {
      initPwa();
    }
    document.addEventListener('astro:page-load', initPwa);
  })();
</script>
