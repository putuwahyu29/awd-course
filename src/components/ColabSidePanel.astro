---
interface Props {
  colabUrl?: string;
  ipynbFile?: string;
}

const { 
  colabUrl = 'https://colab.research.google.com', 
  ipynbFile = '/notebooks/costar-1-dasar-python.ipynb' 
} = Astro.props;

const isRunnerEnabled = import.meta.env.PUBLIC_ENABLE_CODE_RUNNER === 'true';
---

<!-- Floating Trigger Button for Colab Companion -->
<div class="colab-companion-launcher">
  <button id="open-colab-panel-btn" class="companion-btn" aria-label="Buka Google Colab Companion">
    <svg viewBox="0 0 24 24" width="18" height="18">
      <path fill="#F9AB00" d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.12 14.86l-3.32 3.32a.75.75 0 0 1-1.06 0l-5.6-5.6a.75.75 0 0 1 0-1.06l3.32-3.32a.75.75 0 0 1 1.06 0l5.6 5.6a.75.75 0 0 1 0 1.06z"/>
    </svg>
    <span>Colab Workspace</span>
  </button>
</div>

<!-- Slide-over Workspace Drawer -->
<div id="colab-panel-backdrop" class="panel-backdrop hidden"></div>

<aside id="colab-workspace-drawer" class="colab-drawer hidden">
  <div class="drawer-header">
    <div class="drawer-header-left">
      <svg viewBox="0 0 24 24" width="22" height="22">
        <path fill="#F9AB00" d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.12 14.86l-3.32 3.32a.75.75 0 0 1-1.06 0l-5.6-5.6a.75.75 0 0 1 0-1.06l3.32-3.32a.75.75 0 0 1 1.06 0l5.6 5.6a.75.75 0 0 1 0 1.06z"/>
      </svg>
      <div>
        <h4 class="drawer-title">Google Colab Workspace</h4>
        <span class="drawer-status">Sesi Akun Google Mandiri</span>
      </div>
    </div>

    <button id="close-colab-panel-btn" class="close-drawer-btn" aria-label="Tutup Workspace">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div class="drawer-body">
    <div class="card p-4 bg-surface-elevated">
      <h5 class="font-bold text-sm mb-1 text-main">Mode Side-by-Side (Layar Berdampingan)</h5>
      <p class="text-xs text-muted leading-relaxed mb-3">
        Membuka jendela mini Google Colab di sebelah kanan layar komputer Anda, sehingga Anda bisa menyimak materi di kiri sambil mengeksekusi kode di kanan secara bersamaan.
      </p>

      <div class="flex flex-col gap-2">
        <button id="launch-sidebyside-colab-btn" data-url={colabUrl} class="btn btn-primary btn-sm justify-center">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
          <span>Buka Jendela Samping (Side-by-Side)</span>
        </button>

        {ipynbFile && (
          <a href={ipynbFile} download class="btn btn-outline btn-sm justify-center">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            <span>Unduh Notebook (.ipynb)</span>
          </a>
        )}
      </div>
    </div>

    <!-- Mini Python Scratchpad in Drawer -->
    {isRunnerEnabled && (
      <div class="scratchpad-box card">
        <div class="scratchpad-header">
          <span class="text-xs font-bold uppercase text-muted">Scratchpad Python Cepat</span>
          <button id="run-scratchpad-btn" class="btn btn-primary btn-sm py-1 px-2 text-xs">
            ▶ Run
          </button>
        </div>
        <textarea id="scratchpad-code" class="scratchpad-textarea" spellcheck="false" rows="6"># Uji coba kode cepat di sini&#10;import math&#10;&#10;hasil = [math.sqrt(x) for x in [4, 9, 16, 25, 36]]&#10;print("Hasil akar:", hasil)</textarea>
        <div id="scratchpad-output-wrap" class="scratchpad-output hidden">
          <span class="text-[10px] font-bold text-muted uppercase">Output:</span>
          <pre class="text-xs font-mono text-cyan-400 mt-1 m-0"><code id="scratchpad-out-text"></code></pre>
        </div>
      </div>
    )}
  </div>
</aside>

<script>
  function setupColabPanel() {
    const openBtn = document.getElementById('open-colab-panel-btn');
    const closeBtn = document.getElementById('close-colab-panel-btn');
    const drawer = document.getElementById('colab-workspace-drawer');
    const backdrop = document.getElementById('colab-panel-backdrop');
    const launchSideBtn = document.getElementById('launch-sidebyside-colab-btn');

    function openDrawer() {
      drawer?.classList.remove('hidden');
      backdrop?.classList.remove('hidden');
    }

    function closeDrawer() {
      drawer?.classList.add('hidden');
      backdrop?.classList.add('hidden');
    }

    openBtn?.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Launch true Side-by-side popup window
    launchSideBtn?.addEventListener('click', () => {
      const url = launchSideBtn.getAttribute('data-url') || 'https://colab.research.google.com';
      const width = Math.floor(window.screen.availWidth * 0.48);
      const height = window.screen.availHeight;
      const left = window.screen.availWidth - width;
      window.open(url, 'ColabCompanionWindow', `width=${width},height=${height},left=${left},top=0,menubar=no,toolbar=no,location=no,status=no`);
    });

    // Scratchpad runner
    const runScratchpad = document.getElementById('run-scratchpad-btn');
    const scratchText = document.getElementById('scratchpad-code') as HTMLTextAreaElement;
    const outWrap = document.getElementById('scratchpad-output-wrap');
    const outText = document.getElementById('scratchpad-out-text');

    runScratchpad?.addEventListener('click', async () => {
      if (!scratchText || !outText) return;
      outWrap?.classList.remove('hidden');
      outText.textContent = 'Memproses...';

      try {
        // @ts-ignore
        if (!window.loadPyodide) {
          const s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/pyodide.js';
          document.head.appendChild(s);
          await new Promise((res) => (s.onload = res));
        }
        // @ts-ignore
        const py = await window.loadPyodide({
          indexURL: 'https://cdn.jsdelivr.net/pyodide/v0.26.2/full/',
        });

        let logs = '';
        py.setStdout({ batched: (m: string) => { logs += m + '\n'; } });
        py.setStderr({ batched: (m: string) => { logs += 'Error: ' + m + '\n'; } });

        const res = await py.runPythonAsync(scratchText.value);
        outText.textContent = logs || String(res || '[Selesai]');
      } catch (err: any) {
        console.error('Scratchpad error:', err);
        const errStr = String(err?.message || err || '').toLowerCase();
        if (errStr.includes('fetch') || errStr.includes('network') || errStr.includes('script')) {
          outText.textContent = 'Gagal mengunduh modul Python dari CDN. Pastikan koneksi internet Anda stabil.';
        } else {
          outText.textContent = `Pesan Kesalahan:\n${err.message || err}`;
        }
      }
    });
  }

  setupColabPanel();
  document.addEventListener('astro:page-load', setupColabPanel);
</script>

<style>
  .colab-companion-launcher {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 40;
  }

  .companion-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: 9999px;
    box-shadow: var(--shadow-lg);
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .companion-btn:hover {
    transform: translateY(-2px);
    border-color: #f59e0b;
    box-shadow: var(--shadow-xl);
  }

  .panel-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: 60;
  }

  .colab-drawer {
    position: fixed;
    top: 0;
    right: 0;
    width: 100%;
    max-width: 420px;
    height: 100vh;
    background-color: var(--bg-surface);
    border-left: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-xl);
    z-index: 70;
    display: flex;
    flex-direction: column;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    background-color: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .drawer-header-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .drawer-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
  }

  .drawer-status {
    font-size: 0.725rem;
    color: var(--accent-emerald);
    font-weight: 600;
  }

  .close-drawer-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .drawer-body {
    padding: 1.25rem;
    overflow-y: auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .scratchpad-box {
    padding: 0.85rem;
    background-color: var(--bg-surface);
  }

  .scratchpad-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .scratchpad-textarea {
    width: 100%;
    background-color: #0d1117;
    color: #e6edf3;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid #30363d;
    outline: none;
    resize: vertical;
  }

  .scratchpad-output {
    margin-top: 0.5rem;
    padding: 0.5rem;
    background-color: #161b22;
    border-radius: var(--radius-sm);
  }

  .hidden {
    display: none !important;
  }
</style>
