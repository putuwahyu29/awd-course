---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import YouTube from '../components/mdx/YouTube.astro';
import PDFViewer from '../components/mdx/PDFViewer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import PresentationMode from '../components/PresentationMode.astro';
import ChatWidget from '../components/ChatWidget.astro';
import SearchModal from '../components/SearchModal.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  course: any;
  lessons: any[];
  currentLesson: any;
  headings?: { depth: number; slug: string; text: string }[];
}

const { course, lessons, currentLesson, headings = [] } = Astro.props;

// Sort lessons by order
const sortedLessons = [...lessons].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const currentIndex = sortedLessons.findIndex((l) => l.id === currentLesson.id);
const prevLesson = currentIndex > 0 ? sortedLessons[currentIndex - 1] : null;
const nextLesson = currentIndex < sortedLessons.length - 1 ? sortedLessons[currentIndex + 1] : null;

// Filter headings for ToC (depth 2 to 4)
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 4);

function formatIndonesianDate(dateStr?: string): string {
  if (!dateStr) return '20 Agu 2026';
  try {
    const parts = dateStr.split('-');
    if (parts.length === 3) {
      const months = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];
      const mIdx = parseInt(parts[1], 10) - 1;
      return `${parseInt(parts[2], 10)} ${months[mIdx] || parts[1]} ${parts[0]}`;
    }
  } catch (e) {}
  return dateStr;
}

const formattedDate = formatIndonesianDate(currentLesson.data.updatedAt || course.data.updatedAt || '2026-09-08');
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://course.awd.my.id';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL('/images/og-banner.jpg', siteUrl);

const isAssignment = currentLesson?.data?.contentType === 'assignment';
const isDocumentModule = currentLesson?.data?.contentType === 'pdf' || Boolean(currentLesson?.data?.pdfUrl);
const showAiBox = !isAssignment && !isDocumentModule;

const jsonLdCourse = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: course.data.title,
  description: course.data.description,
  provider: {
    '@type': 'Person',
    name: course.data.instructor || 'I Putu Agus Wahyu Dupayana',
    jobTitle: course.data.instructorRole || 'Software Engineer',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: course.data.duration || '6 Jam',
  },
};

const jsonLdBreadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Beranda',
      item: siteUrl,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Katalog Kursus',
      item: `${siteUrl}/courses`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: course.data.title,
      item: `${siteUrl}/courses/${course.id}`,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: currentLesson.data.title,
      item: canonicalURL.href,
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Performance & Font Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />

    <!-- SEO Primary Meta Tags -->
    <title>{currentLesson.data.title} | {course.data.title} | Awd Course</title>
    <meta name="title" content={`${currentLesson.data.title} | ${course.data.title} | Awd Course`} />
    <meta name="description" content={`Pelajari ${currentLesson.data.title} (${currentLesson.data.chapter}) dalam kursus ${course.data.title}. Waktu belajar: ${currentLesson.data.duration}.`} />
    <meta name="author" content={course.data.instructor || 'I Putu Agus Wahyu Dupayana'} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme Color Tags -->
    <meta name="theme-color" content="#0b0f19" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Awd Course" />
    <meta property="og:title" content={`${currentLesson.data.title} - ${course.data.title}`} />
    <meta property="og:description" content={`Pelajari ${currentLesson.data.title} dalam kursus ${course.data.title}.`} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`${currentLesson.data.title} - ${course.data.title}`} />
    <meta name="twitter:description" content={`Pelajari ${currentLesson.data.title} dalam kursus ${course.data.title}.`} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdCourse)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdBreadcrumbs)} />

    <!-- Client-Side SPA Router / View Transitions -->
    <ClientRouter />

    <script is:inline>
      function applyTheme() {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        })();
        document.documentElement.setAttribute('data-theme', theme);
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="reader-body">
    <!-- Top Global Course Progress Bar -->
    <div class="global-top-progress-track">
      <div id="top-global-progress-bar" class="global-top-progress-fill" style="width: 0%;"></div>
    </div>

    <Header currentPath="/courses" />

    <!-- Mobile Sticky Subheader Bar (Visible on < 1100px) -->
    <div class="mobile-reader-bar">
      <div class="mobile-reader-bar-left">
        <button id="mobile-sidebar-open-btn" class="btn btn-secondary btn-sm mobile-action-btn" aria-label="Buka Silabus Modul">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span>Silabus</span>
        </button>

        {tocHeadings.length > 0 && (
          <button id="mobile-toc-open-btn" class="btn btn-secondary btn-sm mobile-action-btn" aria-label="Buka Daftar Isi Materi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            <span>Daftar Isi ({tocHeadings.length})</span>
          </button>
        )}

        <button type="button" class="btn btn-secondary btn-sm mobile-action-btn btn-trigger-presentation" aria-label="Buka Mode Presentasi Slide">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" class="text-primary">
            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
            <line x1="8" y1="21" x2="16" y2="21"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
          </svg>
          <span>Slide</span>
        </button>
      </div>

      <span class="mobile-progress-badge" id="mobile-progress-percent-text">0% Selesai</span>
    </div>

    <div class="course-reader-layout">
      <!-- Left Sticky Sidebar Navigation -->
      <Sidebar course={course} lessons={sortedLessons} currentLessonSlug={currentLesson.id} currentLessonId={currentLesson.id} />

      <!-- Center Main Lesson Content -->
      <main class="reader-main">
        <div class="reader-inner">
          <div class="lesson-article-wrapper">
            <!-- Breadcrumbs -->
            <nav class="reader-breadcrumbs" aria-label="Breadcrumb">
              <a href="/courses">Kursus</a>
              <span class="crumb-sep">/</span>
              <a href={`/courses/${course.id}`}>{course.data.title}</a>
              <span class="crumb-sep">/</span>
              <span class="current-crumb">{currentLesson.data.chapter}</span>
            </nav>

            <header class="lesson-header">
              <h1 class="lesson-title">{currentLesson.data.title}</h1>

              <div class="lesson-meta-bar">
                <div class="meta-left">
                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"></circle>
                      <polyline points="12 6 12 12 16 14"></polyline>
                    </svg>
                    <span>{currentLesson.data.duration}</span>
                  </span>

                  <span class="meta-dot">•</span>

                  <span class="meta-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                      <line x1="16" y1="2" x2="16" y2="6"></line>
                      <line x1="8" y1="2" x2="8" y2="6"></line>
                      <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    <span>Pembaruan: {formattedDate}</span>
                  </span>

                  {currentLesson.data.contentType === 'video' && (
                    <span class="type-pill text-rose">• Video Tutorial</span>
                  )}
                  {currentLesson.data.contentType === 'pdf' && (
                    <span class="type-pill text-amber">• Modul PDF</span>
                  )}
                  {currentLesson.data.contentType === 'assignment' && (
                    <span class="type-pill text-amber">• Tugas Praktik</span>
                  )}
                </div>

                <div class="meta-right">
                  <button type="button" class="btn btn-secondary btn-sm btn-trigger-presentation desktop-presentation-btn" title="Buka Mode Presentasi Slide & Pointer (Tekan P)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" class="text-primary" aria-hidden="true">
                      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                      <line x1="8" y1="21" x2="16" y2="21"></line>
                      <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    <span>Mode Presentasi (P)</span>
                  </button>
                </div>
              </div>

              {currentLesson.data.isPublished === false && (
                <div class="card" style="margin-top: 1rem; padding: 0.85rem 1.15rem; background-color: var(--bg-surface-elevated); border-left: 3px solid var(--border-medium); display: flex; align-items: center; gap: 0.75rem;">
                  <div style="font-size: 0.85rem; color: var(--text-muted);">
                    <strong style="color: var(--text-main);">Pratinjau Materi:</strong> Modul ini sedang dalam tahap penyesuaian materi oleh pengajar.
                  </div>
                </div>
              )}
            </header>

            <!-- Optional Auto-Embed Media from Frontmatter -->
            {currentLesson.data.youtubeId && (
              <div class="media-container">
                <YouTube id={currentLesson.data.youtubeId} title={currentLesson.data.title} />
              </div>
            )}

            {currentLesson.data.pdfUrl && (
              <div class="media-container">
                <PDFViewer
                  file={currentLesson.data.pdfUrl}
                  title={currentLesson.data.pdfTitle || 'Modul Pembelajaran (PDF)'}
                />
              </div>
            )}

            <!-- In-Lesson AI Assistant Box (Only on regular lessons, hidden on assignments & document/pdf modules) -->
            {showAiBox && (
              <div class="lesson-ai-action-box card">
                <div class="ai-box-top">
                  <div class="ai-box-identity">
                    <div class="ai-box-avatar">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                        <circle cx="12" cy="5" r="2"></circle>
                        <path d="M12 7v4"></path>
                      </svg>
                    </div>
                    <div class="ai-box-text">
                      <span class="ai-box-heading">Asisten AI Modul</span>
                      <span class="ai-box-sub">Tanyakan materi, ringkasan, atau penjelasan kode bab ini langsung ke AI</span>
                    </div>
                  </div>
                </div>
                <div class="ai-box-grid">
                  <button type="button" class="ai-quick-action-card" data-ai-prompt={`Tolong buatkan ringkasan 3 poin kunci terpenting dari modul '${currentLesson.data.title}' dalam kursus '${course.data.title}'.`}>
                    <div class="ai-action-icon">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                      </svg>
                    </div>
                    <div class="ai-action-info">
                      <strong>Rangkum Poin Kunci</strong>
                      <span>Ringkasan inti materi bab ini</span>
                    </div>
                  </button>
                  <button type="button" class="ai-quick-action-card" data-ai-prompt={`Apa saja konsep kunci atau istilah teknis penting yang wajib saya pahami pada materi '${currentLesson.data.title}'? Tolong jelaskan dengan analogi sederhana.`}>
                    <div class="ai-action-icon">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
                      </svg>
                    </div>
                    <div class="ai-action-info">
                      <strong>Jelaskan Konsep</strong>
                      <span>Istilah dan penjelasan materi</span>
                    </div>
                  </button>
                  <button type="button" class="ai-quick-action-card" data-ai-prompt={`Berikan contoh kode atau studi kasus praktis tambahan yang relevan dengan topik '${currentLesson.data.title}'.`}>
                    <div class="ai-action-icon">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                      </svg>
                    </div>
                    <div class="ai-action-info">
                      <strong>Contoh Kode Praktik</strong>
                      <span>Studi kasus tambahan</span>
                    </div>
                  </button>
                  <button type="button" class="ai-quick-action-card" data-ai-prompt={`Saya sedang mempelajari materi '${currentLesson.data.title}' di kursus '${course.data.title}'. Ada beberapa hal yang ingin saya tanyakan seputar bab ini.`}>
                    <div class="ai-action-icon">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                        <line x1="12" y1="17" x2="12.01" y2="17"></line>
                      </svg>
                    </div>
                    <div class="ai-action-info">
                      <strong>Tanya Apapun</strong>
                      <span>Buka sesi tanya jawab bebas</span>
                    </div>
                  </button>
                </div>
              </div>
            )}

            <!-- Lesson Body MDX -->
            <article class="prose lesson-body" data-content-type={currentLesson.data.contentType || 'lesson'}>
              <slot />
            </article>

            <!-- Lesson Completion Box & Navigation Grid -->
            <div class="lesson-navigation-card card">
              <div class="lesson-completion-row">
                <div class="completion-prompt">
                  <div class="completion-icon-bubble">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" class="text-primary">
                      <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                      <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                  </div>
                  <div class="completion-text">
                    <strong class="completion-title">Progres Pembelajaran</strong>
                    <span class="completion-desc">Tandai modul ini selesai setelah Anda memahami teori dan mempraktikkan kode.</span>
                  </div>
                </div>

                <button
                  type="button"
                  class="btn btn-secondary mark-done-btn"
                  id="lesson-mark-done-btn"
                  data-lesson-id={currentLesson.id}
                  data-course-id={course.id}
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16" class="done-check-icon">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span class="done-btn-text">Tandai Selesai</span>
                </button>
              </div>

              <div class="lesson-nav-divider"></div>

              <div class="lesson-nav-grid">
                {prevLesson ? (
                  <a href={`/courses/${course.id}/${prevLesson.id}`} class="nav-direction-card prev-card">
                    <div class="nav-direction-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18">
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </div>
                    <div class="nav-direction-content">
                      <span class="nav-direction-sub">Materi Sebelumnya</span>
                      <strong class="nav-direction-title">{prevLesson.data.title}</strong>
                    </div>
                  </a>
                ) : (
                  <a href={`/courses/${course.id}`} class="nav-direction-card prev-card back-to-syllabus">
                    <div class="nav-direction-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </div>
                    <div class="nav-direction-content">
                      <span class="nav-direction-sub">Menu Utama</span>
                      <strong class="nav-direction-title">Daftar Silabus Kursus</strong>
                    </div>
                  </a>
                )}

                {nextLesson ? (
                  <a href={`/courses/${course.id}/${nextLesson.id}`} class="nav-direction-card next-card">
                    <div class="nav-direction-content">
                      <span class="nav-direction-sub">Materi Selanjutnya</span>
                      <strong class="nav-direction-title">{nextLesson.data.title}</strong>
                    </div>
                    <div class="nav-direction-icon icon-primary">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </div>
                  </a>
                ) : (
                  <a href={`/courses/${course.id}`} class="nav-direction-card next-card finish-card">
                    <div class="nav-direction-content">
                      <span class="nav-direction-sub">Selamat! Kursus Selesai</span>
                      <strong class="nav-direction-title">Kembali ke Silabus</strong>
                    </div>
                    <div class="nav-direction-icon icon-emerald">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                  </a>
                )}
              </div>
            </div>
          </div>
        </div>
      </main>

      <!-- Right Aside Table of Contents (Desktop Sticky Sidebar) -->
      {tocHeadings.length > 0 && (
        <aside class="toc-aside">
          <div class="toc-sticky-container">
            <h4 class="toc-heading">Daftar Isi Materi</h4>
            <ul class="toc-nav-list">
              {tocHeadings.map((h) => (
                <li class={`toc-nav-item toc-level-${h.depth}`}>
                  <a href={`#${h.slug}`} class="toc-nav-link">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>

    <!-- Mobile Slide-Up Sheet for Table of Contents -->
    {tocHeadings.length > 0 && (
      <div id="mobile-toc-drawer" class="mobile-toc-drawer hidden">
        <div id="mobile-toc-backdrop" class="mobile-toc-backdrop"></div>
        <div class="mobile-toc-panel">
          <div class="mobile-toc-handle-bar">
            <div class="mobile-toc-handle"></div>
          </div>
          <div class="mobile-toc-header">
            <div class="mobile-toc-header-left">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18" class="text-primary">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <h3 class="mobile-toc-title">Daftar Isi Materi</h3>
            </div>
            <button id="mobile-toc-close-btn" class="mobile-toc-close" aria-label="Tutup Daftar Isi">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="mobile-toc-body">
            <ul class="mobile-toc-list">
              {tocHeadings.map((h) => (
                <li class={`mobile-toc-item toc-level-${h.depth}`}>
                  <a href={`#${h.slug}`} class="mobile-toc-link">
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )}

    <!-- Global Scroll To Top Button -->
    <ScrollToTop />

    <!-- Presentation Mode Interactive Overlay Engine -->
    <PresentationMode course={course} currentLesson={currentLesson} />

    <!-- Global AI Assistant Chatbot (Mistral AI) -->
    <ChatWidget />

    <!-- Global Search Modal (Ctrl + K) -->
    <SearchModal />

    <!-- Floating Text Selection AI Tooltip -->
    <div id="awd-text-ai-tooltip" class="text-selection-ai-tooltip hidden">
      <button id="awd-selection-ai-btn" type="button" class="selection-ai-btn">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
          <circle cx="12" cy="12" r="4"></circle>
        </svg>
        <span>Tanya AI</span>
      </button>
    </div>

    <script>
      import { supabase, isSupabaseConfigured } from '../lib/supabase';

      function setupLessonAIInteractions() {
        const lessonTitle = document.querySelector('.lesson-title')?.textContent?.trim() || 'Modul Kursus';
        const courseTitle = document.querySelector('.reader-breadcrumbs a:nth-child(3)')?.textContent?.trim() || 'AWD Course';

        const isAssignmentLesson = document.querySelector('.lesson-body')?.getAttribute('data-content-type') === 'assignment';

        function sendPromptToAwdBot(prompt: string, autoSubmit: boolean = true) {
          if (!prompt) return;
          if (typeof (window as any).openAwdChatWithPrompt === 'function') {
            (window as any).openAwdChatWithPrompt(prompt, autoSubmit);
            return;
          }

          // Custom Event dispatch fallback
          window.dispatchEvent(new CustomEvent('awd:open-chat', { detail: { prompt, autoSubmit } }));

          // Direct DOM fallback
          const modal = document.getElementById('awd-chat-modal');
          const backdrop = document.getElementById('awd-chat-backdrop');
          const input = document.getElementById('chat-input') as HTMLTextAreaElement | null;
          const sendBtn = document.getElementById('chat-send-btn') as HTMLButtonElement | null;
          const form = document.getElementById('chat-form') as HTMLFormElement | null;

          if (modal) {
            modal.classList.remove('hidden');
            if (backdrop) backdrop.classList.remove('hidden');
            document.body.classList.add('awd-chat-open');
          }
          if (input) {
            input.value = prompt;
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 120) + 'px';
          }
          if (autoSubmit) {
            setTimeout(() => {
              if (sendBtn && !sendBtn.disabled) {
                sendBtn.click();
              } else if (form) {
                try {
                  form.requestSubmit();
                } catch (err) {
                  form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                }
              }
            }, 150);
          } else if (input) {
            input.focus();
          }
        }

        // 1. Setup Code Block Toolbars (Tanya AI & Salin) - Only for standard markdown pre blocks
        const codeBlocks = document.querySelectorAll('.lesson-body pre');
        codeBlocks.forEach((pre) => {
          if (
            isAssignmentLesson ||
            pre.closest('.code-cell-container') ||
            pre.closest('.code-runner-card') ||
            pre.closest('.interactive-notebook-wrap') ||
            pre.closest('.multi-lang-runner') ||
            pre.closest('.code-output-wrapper') ||
            pre.closest('.output-wrapper') ||
            pre.closest('.output-console') ||
            pre.closest('.admin-solution-wrapper') ||
            pre.classList.contains('output-console') ||
            (pre as HTMLElement).dataset.language === 'text'
          ) {
            return;
          }
          if (pre.querySelector('.code-block-header')) return; // Avoid duplicate

          const codeEl = pre.querySelector('code');
          const rawCode = (codeEl ? codeEl.innerText : (pre as HTMLElement).innerText) || '';

          // Detect language
          let lang = (pre as HTMLElement).dataset.language || '';
          if (!lang && codeEl) {
            const cls = codeEl.className || '';
            const match = cls.match(/language-([a-zA-Z0-9_-]+)/);
            if (match) lang = match[1];
          }
          if (!lang) {
            const preCls = (pre as HTMLElement).className || '';
            const preMatch = preCls.match(/language-([a-zA-Z0-9_-]+)/);
            if (preMatch) lang = preMatch[1];
          }
          if (!lang) lang = 'code';

          const header = document.createElement('div');
          header.className = 'code-block-header';
          header.innerHTML = `
            <span class="code-lang-badge">${lang}</span>
            <div class="code-header-actions">
              <button type="button" class="code-ai-btn" title="Tanyakan atau minta penjelasan kode ini ke AI">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
                  <circle cx="12" cy="12" r="4"></circle>
                </svg>
                <span>Tanya AI</span>
              </button>
              <button type="button" class="code-copy-btn" title="Salin Kode">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Salin</span>
              </button>
            </div>
          `;

          pre.insertBefore(header, pre.firstChild);

          // AI Button Click
          const aiBtn = header.querySelector('.code-ai-btn');
          if (aiBtn) {
            aiBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              const currentCode = (pre.querySelector('code')?.innerText || rawCode || '').trim();
              const prompt = `Saya sedang mempelajari modul '${lessonTitle}' pada kursus '${courseTitle}'. Tolong jelaskan potongan kode ${lang} berikut secara detail, baris per baris dan fungsinya:\n\n\`\`\`${lang}\n${currentCode}\n\`\`\``;
              sendPromptToAwdBot(prompt, true);
            });
          }

          // Copy Button Click
          const copyBtn = header.querySelector('.code-copy-btn');
          if (copyBtn) {
            copyBtn.addEventListener('click', async (e) => {
              e.stopPropagation();
              try {
                const currentCode = (pre.querySelector('code')?.innerText || rawCode || '').trim();
                await navigator.clipboard.writeText(currentCode);
                const origHTML = copyBtn.innerHTML;
                copyBtn.innerHTML = `<span>✓ Tersalin!</span>`;
                (copyBtn as HTMLElement).style.color = '#10b981';
                setTimeout(() => {
                  copyBtn.innerHTML = origHTML;
                  (copyBtn as HTMLElement).style.color = '';
                }, 2000);
              } catch (err) {
                console.warn('Copy failed', err);
              }
            });
          }
        });

        // 2. Setup In-Lesson AI Quick Action Cards
        const aiQuickBtns = document.querySelectorAll('[data-ai-prompt]');
        aiQuickBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const prompt = btn.getAttribute('data-ai-prompt');
            if (prompt) {
              sendPromptToAwdBot(prompt, true);
            }
          });
        });

        // 3. Setup Text Selection Floating Tooltip
        const tooltip = document.getElementById('awd-text-ai-tooltip');
        const selectionBtn = document.getElementById('awd-selection-ai-btn');
        const lessonBody = document.querySelector('.lesson-body');

        let selectedTextToQuery = '';

        if (tooltip && selectionBtn && lessonBody) {
          document.addEventListener('mouseup', (e) => {
            if (tooltip.contains(e.target as Node)) return;

            setTimeout(() => {
              const selection = window.getSelection();
              const text = selection ? selection.toString().trim() : '';

              if (text && text.length >= 3 && text.length <= 800) {
                const range = selection?.getRangeAt(0);
                if (range && lessonBody.contains(range.commonAncestorContainer)) {
                  selectedTextToQuery = text;
                  const rect = range.getBoundingClientRect();
                  tooltip.style.top = `${window.scrollY + rect.top - 38}px`;
                  tooltip.style.left = `${window.scrollX + rect.left + rect.width / 2}px`;
                  tooltip.classList.remove('hidden');
                  return;
                }
              }
              tooltip.classList.add('hidden');
            }, 50);
          });

          selectionBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            if (selectedTextToQuery) {
              const prompt = `Saya sedang membaca modul '${lessonTitle}' pada kursus '${courseTitle}'. Tolong jelaskan secara mendalam maksud dan konsep dari bagian berikut:\n\n"${selectedTextToQuery}"`;
              sendPromptToAwdBot(prompt, true);
              tooltip.classList.add('hidden');
              window.getSelection()?.removeAllRanges();
            }
          });
        }
      }

      function setupReaderNavigation() {
        // Mobile sidebar trigger
        const mobileOpenBtn = document.getElementById('mobile-sidebar-open-btn');
        const sidebar = document.getElementById('course-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');

        mobileOpenBtn?.addEventListener('click', () => {
          sidebar?.classList.add('open-mobile');
          backdrop?.classList.remove('hidden');
        });

        // Mobile Table of Contents Sheet Trigger
        const mobileTocOpenBtn = document.getElementById('mobile-toc-open-btn');
        const mobileTocDrawer = document.getElementById('mobile-toc-drawer');
        const mobileTocBackdrop = document.getElementById('mobile-toc-backdrop');
        const mobileTocCloseBtn = document.getElementById('mobile-toc-close-btn');
        const mobileTocLinks = document.querySelectorAll('.mobile-toc-link');

        function openMobileToc() {
          mobileTocDrawer?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function closeMobileToc() {
          mobileTocDrawer?.classList.add('hidden');
          document.body.style.overflow = '';
        }

        mobileTocOpenBtn?.addEventListener('click', openMobileToc);
        mobileTocBackdrop?.addEventListener('click', closeMobileToc);
        mobileTocCloseBtn?.addEventListener('click', closeMobileToc);

        mobileTocLinks.forEach((link) => {
          link.addEventListener('click', () => {
            closeMobileToc();
          });
        });

        // Mark done toggle
        const markDoneBtn = document.getElementById('lesson-mark-done-btn');
        if (!markDoneBtn) return;

        const lessonId = markDoneBtn.getAttribute('data-lesson-id');
        const courseId = markDoneBtn.getAttribute('data-course-id');
        if (!lessonId || !courseId) return;

        const storageKey = `progress_${courseId}`;
        const btnText = markDoneBtn.querySelector('.done-btn-text');

        function updateButtonUI() {
          let list: string[] = [];
          try {
            list = JSON.parse(localStorage.getItem(storageKey) || '[]');
          } catch (e) {
            list = [];
          }

          if (list.includes(lessonId!)) {
            markDoneBtn?.classList.add('is-done');
            if (btnText) btnText.textContent = 'Modul Selesai ✓ (Klik untuk Batal)';
          } else {
            markDoneBtn?.classList.remove('is-done');
            if (btnText) btnText.textContent = 'Tandai Selesai';
          }
        }

        updateButtonUI();

        // Check Supabase if user is logged in
        if (isSupabaseConfigured && supabase) {
          const client = supabase;
          client.auth.getUser().then(({ data: { user } }) => {
            if (user) {
              client
                .from('course_progress')
                .select('lesson_id')
                .eq('user_id', user.id)
                .eq('course_id', courseId)
                .then(({ data, error }) => {
                  if (!error && data) {
                    const dbList = data.map((d: any) => d.lesson_id);
                    let list: string[] = [];
                    try {
                      list = JSON.parse(localStorage.getItem(storageKey) || '[]');
                    } catch (e) {
                      list = [];
                    }
                    const merged = Array.from(new Set([...list, ...dbList]));
                    localStorage.setItem(storageKey, JSON.stringify(merged));
                    updateButtonUI();
                    window.dispatchEvent(new CustomEvent('courseProgressUpdated', { detail: { courseId, list: merged } }));
                  }
                });
            }
          });
        }

        markDoneBtn.addEventListener('click', async () => {
          let list: string[] = [];
          try {
            list = JSON.parse(localStorage.getItem(storageKey) || '[]');
          } catch (e) {
            list = [];
          }

          const isNowDone = !list.includes(lessonId!);
          if (isNowDone) {
            list.push(lessonId!);
          } else {
            list = list.filter((id) => id !== lessonId);
          }

          localStorage.setItem(storageKey, JSON.stringify(list));
          updateButtonUI();

          // Dispatch event for sidebar & top bar
          window.dispatchEvent(new CustomEvent('courseProgressUpdated', { detail: { courseId, list } }));

          // Sync to Supabase in background
          if (isSupabaseConfigured && supabase) {
            const client = supabase;
            try {
              const { data: { user } } = await client.auth.getUser();
              if (user) {
                if (isNowDone) {
                  await client.from('course_progress').upsert({
                    user_id: user.id,
                    course_id: courseId,
                    lesson_id: lessonId,
                  });
                } else {
                  await client.from('course_progress').delete().match({
                    user_id: user.id,
                    course_id: courseId,
                    lesson_id: lessonId,
                  });
                }
              }
            } catch (err) {
              console.warn('Supabase sync error:', err);
            }
          }
        });

        // ScrollSpy for Table of Contents
        const tocLinks = document.querySelectorAll('.toc-nav-link');
        if (tocLinks.length > 0) {
          const headings = document.querySelectorAll('h2[id], h3[id], h4[id], h5[id]');
          
          function updateActiveHeading() {
            let currentId = '';
            headings.forEach((heading) => {
              const top = heading.getBoundingClientRect().top;
              if (top <= 150) {
                currentId = heading.getAttribute('id') || '';
              }
            });

            if (currentId) {
              tocLinks.forEach((link) => {
                if (link.getAttribute('href') === `#${currentId}`) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });

              mobileTocLinks.forEach((link) => {
                if (link.getAttribute('href') === `#${currentId}`) {
                  link.classList.add('active');
                } else {
                  link.classList.remove('active');
                }
              });
            }
          }

          window.addEventListener('scroll', updateActiveHeading, { passive: true });
          updateActiveHeading();
        }
      }

      setupReaderNavigation();
      setupLessonAIInteractions();

      document.addEventListener('astro:page-load', () => {
        setupReaderNavigation();
        setupLessonAIInteractions();
      });
    </script>
  </body>
</html>

